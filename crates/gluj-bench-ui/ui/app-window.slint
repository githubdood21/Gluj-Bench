import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView } from "std-widgets.slint";

export struct DeviceFact { label: string, value: string, }
export struct DeviceRow {
    id: string, name: string, category: string, availability: string, status: string,
    details: string, cache-details: string, accent: color, available: bool,
    description: string, facts: [DeviceFact], badges: [string],
}
export struct BenchmarkRow {
    id: string, name: string, workload: string, availability: string, data-type: string,
    unit: string, enabled: bool, selected: bool, hardware-ready: bool,
}
export struct ChartLabel { x: float, y: float, width: float, text: string, font-size: float, accent: color, alignment: int, }
export struct ChartPoint { x: float, y: float, left: float, bottom: float, value-label: string, dataset-label: string, series: string, display-value: string, accent: color, }
export struct TuningFact { label: string, value: string, detail: string, accent: color, }
export struct TuningBar { label: string, value: string, ratio: float, minimum: float, maximum: float, range-visible: bool, accent: color, }
export struct ResultRow {
    measurement-facts: [TuningFact], measurement-bars: [TuningBar], context-facts: [DeviceFact],
    title: string, device: string, elapsed: string, primary-name: string,
    primary-value: string, sample-count: string,
    fact-one-label: string, fact-one-value: string, fact-two-label: string, fact-two-value: string,
    fact-three-label: string, fact-three-value: string, fact-four-label: string, fact-four-value: string,
    summary: string, diagnosis: string, details: string, description: string, description-tldr: string, everyday-use: string, metric-guide: string, tuning-guidance: string, tuning-tldr: string, tuning-stats: string, memory-pressure: string, tuning-title: string,
    profile-chart: image, profile-labels: [ChartLabel], profile-points: [ChartPoint], profile-sizes: [string], profile-statistics: [string],
    gpu-timing-chart: image, gpu-timing-labels: [ChartLabel], gpu-timing-points: [ChartPoint], gpu-timing-available: bool, gpu-timing-visible: bool, gpu-timing-note: string,
    tuning-facts-top: [TuningFact], tuning-facts-bottom: [TuningFact], tuning-bars: [TuningBar], tuning-allocation: [TuningBar], tuning-actions: [TuningFact], tuning-quality: string,
}

export struct SummaryRow { title: string, metric: string, latest: string, best: string, runs: string, section: int, bandwidth: bool, read-latest: string, write-latest: string, copy-latest: string, read-best: string, write-best: string, copy-best: string, delta: string, read-delta: string, write-delta: string, copy-delta: string, }

component SectionTitle inherits Text { color: #f4f7fb; font-size: 25px; font-weight: 700; }
component Surface inherits Rectangle { background: #151b26; border-color: #293448; border-width: 1px; border-radius: 14px; }
component Label inherits Text { color: #8f9caf; font-size: 11px; font-weight: 700; }
component InteractiveChart inherits Rectangle {
    in property <image> chart;
    in property <[ChartLabel]> labels;
    in property <[ChartPoint]> points;
    in property <float> source-height;
    pure callback pick-point(float, float, float, float) -> int;
    private property <float> cursor-x: pointer.mouse-x / root.width * 900;
    private property <float> cursor-y: pointer.mouse-y / root.height * root.source-height;
    private property <float> plot-bottom: root.source-height == 420 ? (root.cursor-y >= 42 && root.cursor-y <= 162 ? 162 : root.cursor-y >= 232 && root.cursor-y <= 352 ? 352 : -1) : (root.cursor-y >= 60 && root.cursor-y <= 220 ? 220 : -1);
    private property <bool> over-plot: pointer.has-hover && root.cursor-x >= 110 && root.cursor-x <= 870 && root.plot-bottom > 0;
    private property <int> active: root.over-plot ? root.pick-point(pointer.mouse-x / 1px, pointer.mouse-y / 1px, root.width / 1px, root.height / 1px) : -1;
    private property <ChartPoint> point: root.active >= 0 && root.active < root.points.length ? root.points[root.active] : {};
    private property <float> guide-x: root.active >= 0 ? root.point.x : root.cursor-x;
    private property <float> guide-y: root.active >= 0 ? root.point.y : root.cursor-y;
    private property <float> guide-bottom: root.active >= 0 ? root.point.bottom : root.plot-bottom;
    private property <color> guide-color: root.active >= 0 ? root.point.accent : #91b8c3;
    height: self.width * root.source-height / 900;
    vertical-stretch: 0;
    Image { width: parent.width; height: parent.height; source: root.chart; image-fit: contain; }
    for label in root.labels: Text { x: root.width * label.x / 900; y: root.height * label.y / root.source-height; width: root.width * label.width / 900; height: max(22px, root.height * 22 / root.source-height); text: label.text; color: label.accent; font-size: max(11px, root.width * label.font-size / 900); horizontal-alignment: label.alignment == 0 ? left : label.alignment == 1 ? center : right; }
    if root.over-plot: Rectangle { x: root.width * 110 / 900; y: root.height * root.guide-y / root.source-height; width: root.width * (root.guide-x - 110) / 900; height: 1px; background: root.guide-color; }
    if root.over-plot: Rectangle { x: root.width * root.guide-x / 900; y: root.height * root.guide-y / root.source-height; width: 1px; height: root.height * (root.guide-bottom - root.guide-y) / root.source-height; background: root.guide-color; }
    if root.active >= 0: Rectangle { x: root.width * root.point.x / 900 - 5px; y: root.height * root.point.y / root.source-height - 5px; width: 10px; height: 10px; border-radius: 5px; background: root.point.accent; border-width: 2px; border-color: #ffffff; }
    if root.active >= 0: Rectangle { x: 0px; y: max(0px, root.height * root.point.y / root.source-height - 11px); width: root.width * 108 / 900; height: 22px; background: #20364a; border-radius: 3px;
        Text { text: root.point.value-label; color: root.point.accent; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
    if root.active >= 0: Rectangle { x: clamp(root.width * root.point.x / 900 - 75px, 0px, root.width - 150px); y: root.height * root.point.bottom / root.source-height + 4px; width: 150px; height: 23px; background: #20364a; border-radius: 3px;
        Text { text: root.point.dataset-label; color: root.point.accent; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.active >= 0: tooltip := Rectangle { width: min(260px, root.width - 120px); height: tooltip-content.preferred-height; x: clamp(root.width * root.point.x / 900 + 12px, 80px, root.width - self.width - 8px); y: clamp(root.height * root.point.y / root.source-height - self.height - 12px, 4px, root.height - self.height - 4px); background: #172d3e; border-width: 1px; border-color: root.point.accent; border-radius: 7px;
        tooltip-content := VerticalLayout { padding: 12px; spacing: 6px; alignment: start;
            Text { text: root.point.series; color: #a5bec6; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
            Text { text: root.point.display-value; color: root.point.accent; font-size: 20px; font-weight: 700; wrap: word-wrap; vertical-stretch: 0; }
            Text { text: root.point.dataset-label + " dataset"; color: #e6f4f2; font-size: 12px; vertical-stretch: 0; }
        }
    }
    pointer := TouchArea { width: parent.width; height: parent.height; mouse-cursor: root.over-plot ? crosshair : default; }
}
export component MainWindow inherits Window {
    pure callback chart-point-at([ChartPoint], float, float, float, float, float) -> int;
    title: "Gluj-Bench";
    in property <string> app-version;
    in property <bool> system-ready: false;
    icon: @image-url("icons/logo-256.png");
    min-width: 980px; min-height: 680px;
    preferred-width: 1280px; preferred-height: 820px;
    background: #0b0f16;

    in-out property <int> page: 0;
    in property <string> default-dataset-mode;
    in property <string> default-dataset-text;
    in property <bool> default-dataset-custom;
    in property <string> default-dataset-error;
    in property <string> default-offload-name;
    callback select-default-configuration(string, int);
    callback edit-default-dataset(string);
    in property <bool> test-override-enabled;
    in property <bool> test-is-cpu;
    in property <bool> test-is-gpu;
    in property <bool> test-is-scaling;
    in property <bool> test-is-offload;
    in property <bool> test-has-ram;
    in property <bool> test-dataset-custom;
    in property <bool> test-configuration-valid;
    in property <string> test-configuration-summary;
    in property <string> test-cpu-name;
    in property <string> test-gpu-name;
    in property <string> test-core-name;
    in property <string> test-ram-name;
    in property <string> test-vram-name;
    in property <string> test-offload-name;
    in property <string> test-dataset-mode;
    in property <string> test-dataset-text;
    callback toggle-test-override(bool);
    callback select-test-configuration(string, int);
    callback edit-test-dataset(string);
    in-out property <string> vram-budget-name;
    callback select-vram-budget(int);
    in-out property <string> ram-budget-name;
    callback select-ram-budget(int);
    in-out property <[string]> cpu-core-options;
    in-out property <string> cpu-core-name;
    callback select-cpu-cores(int);
    in-out property <string> cpu-intensity-name;
    in-out property <string> gpu-intensity-name;
    in-out property <string> settings-status;
    in-out property <string> load-description;
    callback select-cpu-intensity(int);
    callback select-gpu-intensity(int);
    in-out property <string> status: "Starting benchmark worker...";
    in-out property <bool> worker-online: false;
    in-out property <string> suite-description: "";
    in-out property <[string]> gpu-adapters: [];
    in-out property <int> selected-gpu: -1;
    in-out property <string> selected-gpu-name: "No compatible GPU selected";
    in-out property <bool> show-gpu-selector: false;
    in-out property <string> target-hardware-name: "Discovering hardware...";
    in-out property <string> target-hardware-description: "";
    in-out property <string> selected-benchmark-name: "No benchmark selected";
    in-out property <string> selected-benchmark-description: "Select a benchmark to view its details and run it.";
    in-out property <string> selected-benchmark-details;
    in-out property <bool> lab-details-expanded: false;
    in-out property <bool> tuning-details-expanded: false;
    private property <bool> tuning-notes-expanded: false;
    in-out property <string> selected-benchmark-availability: "";
    in-out property <bool> selected-benchmark-enabled: false;
    in-out property <[DeviceRow]> devices: [];
    in-out property <[BenchmarkRow]> benchmarks: [];
    in-out property <[SummaryRow]> result-summaries: [];
    in-out property <[string]> result-components: [];
    in-out property <string> result-component-name;
    in-out property <ResultRow> selected-result;
    in-out property <int> result-count;
    in-out property <int> result-header-count;
    in-out property <bool> result-has-bandwidth;
    in-out property <int> bandwidth-mode: 0;
    in-out property <[string]> comparison-options: [];
    in-out property <string> comparison-name;
    in-out property <string> comparison-note;
    in-out property <string> results-file-status;
    callback select-comparison(int);
    in-out property <int> result-selection;
    callback select-result-component(int);
    callback select-result-row(int);
    in-out property <string> expanded-device-id: "";
    in-out property <bool> result-details-expanded: false;
    private property <int> profile-selection: -1;
    private property <int> profile-index: root.profile-selection >= 0 && root.profile-selection < root.selected-result.profile-sizes.length ? root.profile-selection : root.selected-result.profile-sizes.length - 1;
    private property <bool> profile-raw-expanded: false;
    in-out property <int> device-count: 0;
    in-out property <int> available-device-count: 0;
    in-out property <int> benchmark-count: 0;
    in-out property <bool> running: false;
    in-out property <int> queued-count: 0;
    in-out property <float> progress: 0;
    in-out property <string> progress-message: "";

    callback select-page(int); callback select-suite(string); callback select-gpu(int);
    callback select-benchmark(string); callback toggle-device-details(string); callback toggle-result-details();
    callback run-selected(); callback run-all(); callback cancel(); callback clear-results(); callback rescan-hardware();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 242px; background: #101620; border-color: #263148; border-width: 1px;
            VerticalLayout {
                padding: 22px; spacing: 10px;
                HorizontalLayout { height: 40px; spacing: 10px;
                    Image { width: 38px; height: 38px; source: @image-url("icons/logo.svg"); image-fit: contain; }
                    VerticalLayout { spacing: 1px; Text { text: "GLUJ-BENCH"; color: #f4f7fb; font-size: 18px; font-weight: 800; } Text { text: "HARDWARE BENCHMARKING"; color: #71809a; font-size: 9px; font-weight: 700; } }
                }
                Rectangle { height: 18px; }
                Button { text: "System Information"; primary: root.page == 0; clicked => { root.select-page(0); } }
                Button { text: "Benchmarks"; primary: root.page == 1; clicked => { root.select-page(1); } }
                Button { text: "Benchmark Results"; primary: root.page == 2; clicked => { root.select-page(2); } }
                Button { text: "Settings"; primary: root.page == 3; clicked => { root.select-page(3); } }
                Rectangle { vertical-stretch: 1; }
                Surface {
                    height: 76px; background: root.worker-online ? #10251f : #291a20; border-color: root.worker-online ? #235f4e : #65323c;
                    VerticalLayout { padding: 12px; spacing: 5px;
                        Label { text: root.worker-online ? "ENGINE READY" : "ENGINE OFFLINE"; color: root.worker-online ? #62dfad : #ff8795; }
                        Text { text: root.worker-online ? "Ready to run benchmarks" : "Benchmarks are unavailable"; color: #c2cad7; font-size: 10px; wrap: word-wrap; }
                    }
                }
                Text { text: "GLUJ-BENCH  v" + root.app-version; color: #536178; font-size: 10px; }
            }
        }
        Rectangle {
            horizontal-stretch: 1; background: #0b0f16;
            VerticalLayout {
                padding: 28px; spacing: 16px;
                if root.page == 0: overview-scroll := ScrollView {
                    vertical-stretch: 1; viewport-width: self.width;
                    viewport-height: max(self.visible-height, overview-content.preferred-height);
                    overview-content := VerticalLayout {
                        width: overview-scroll.visible-width - 16px; height: self.preferred-height;
                        spacing: 16px; padding-bottom: 24px; alignment: start;
                        HorizontalLayout { height: 94px; vertical-stretch: 0; spacing: 16px;
                            VerticalLayout { spacing: 6px; horizontal-stretch: 1;
                                Label { text: "HARDWARE & CAPABILITIES"; color: #6ce2cd; letter-spacing: 1px; }
                                Text { text: "System Information"; color: #f4f7fb; font-size: 32px; font-weight: 700; }
                                Text { text: "System components, memory capacity and supported compute features."; color: #9aabc0; font-size: 12px; wrap: word-wrap; }
                            }
                            Button { width: 142px; height: 36px; vertical-stretch: 0; text: "Refresh hardware"; enabled: !root.running; clicked => { root.rescan-hardware(); } }
                        }
                        HorizontalLayout { height: max(26px, readiness-text.preferred-height); vertical-stretch: 0; spacing: 9px;
                            if root.system-ready: Image { width: 20px; height: 20px; source: @image-url("icons/check.svg"); image-fit: contain; }
                            readiness-text := Text {
                                horizontal-stretch: 1; text: root.system-ready ? "Hardware scanned and ready to benchmark" : root.status;
                                color: root.system-ready ? #7ae8ce : #9aabc0; font-size: 12px; wrap: word-wrap; vertical-alignment: center;
                            }
                        }
                        HorizontalLayout { height: 88px; vertical-stretch: 0; spacing: 12px;
                            Surface { horizontal-stretch: 1; VerticalLayout { padding: 14px; spacing: 5px; Label { text: "COMPONENTS"; } Text { text: root.device-count; color: #79aaff; font-size: 27px; font-weight: 700; } } }
                            Surface { horizontal-stretch: 1; VerticalLayout { padding: 14px; spacing: 5px; Label { text: "READY TO BENCHMARK"; } Text { text: root.available-device-count; color: #65dfc4; font-size: 27px; font-weight: 700; } } }
                            Surface { horizontal-stretch: 1; VerticalLayout { padding: 14px; spacing: 5px; Label { text: "SUPPORTED BENCHMARKS"; } Text { text: root.benchmark-count; color: #c9a0ff; font-size: 27px; font-weight: 700; } } }
                        }
                        HorizontalLayout { height: 22px; vertical-stretch: 0;
                            Label { text: "INSIDE YOUR SYSTEM"; color: #9aaec6; letter-spacing: 1px; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "Explore each component below"; color: #63778f; font-size: 11px; }
                        }
                        for device in root.devices: Surface {
                            height: max(224px, hardware-content.preferred-height + 40px);
                            vertical-stretch: 0; background: #141d2a; border-color: #304159;
                            hardware-content := VerticalLayout { padding: 20px; spacing: 14px; alignment: start;
                                HorizontalLayout { spacing: 14px; vertical-stretch: 0;
                                    Rectangle { width: 58px; height: 58px; border-radius: 15px; background: #1b2a3b; border-width: 1px; border-color: device.accent;
                                        Image { width: 46px; height: 46px; x: 6px; y: 6px; source: device.category == "CPU" ? @image-url("icons/cpu.svg") : device.category == "MEMORY" ? @image-url("icons/memory.svg") : @image-url("icons/gpu.svg"); image-fit: contain; }
                                    }
                                    VerticalLayout { horizontal-stretch: 1; spacing: 5px;
                                        Label { text: device.category == "CPU" ? "PROCESSOR" : device.category == "MEMORY" ? "SYSTEM MEMORY" : "GRAPHICS DEVICE"; color: device.accent; letter-spacing: 1px; }
                                        Text { text: device.name; color: #f0f5fc; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                                    }
                                    Button { width: 88px; height: 32px; vertical-stretch: 0; text: root.expanded-device-id == device.id ? "Less detail" : "Details"; clicked => { root.toggle-device-details(device.id); } }
                                }
                                Text { text: device.description; color: #a8b9ce; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout { spacing: 10px; vertical-stretch: 0;
                                    for fact in device.facts: Rectangle {
                                        horizontal-stretch: 1; height: max(66px, fact-content.preferred-height + 20px); background: #0f1723; border-radius: 8px;
                                        fact-content := VerticalLayout { padding: 10px; spacing: 6px;
                                            Text { text: fact.label; color: #8195af; font-size: 10px; wrap: word-wrap; }
                                            Text { text: fact.value; color: #e1ecf9; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                                        }
                                    }
                                }
                                HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                    Rectangle { width: 94px; height: 30px; border-radius: 7px; background: device.available ? #17382f : #3a3020;
                                        Text { text: device.available ? "Ready to test" : "Unavailable"; color: device.available ? #72e7c5 : #f3ba67; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    for badge in device.badges: Rectangle { horizontal-stretch: 1; height: max(30px, badge-text.preferred-height + 12px); background: #202d40; border-radius: 7px;
                                        badge-text := Text { x: 8px; y: 6px; width: parent.width - 16px; height: self.preferred-height; text: badge; color: #adc4e3; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                }
                                if root.expanded-device-id == device.id: VerticalLayout { spacing: 10px; vertical-stretch: 0;
                                    Rectangle { height: 1px; background: #304159; }
                                    Label { text: "HARDWARE DETAILS"; color: device.accent; }
                                    Text { text: device.status; color: #adbed3; font-size: 11px; wrap: word-wrap; }
                                    Text { text: device.cache-details; color: #83cfc9; font-size: 11px; wrap: word-wrap; }
                                    Text { text: device.details; color: #9aadca; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
                if root.page == 1: HorizontalLayout {
                    spacing: 18px;
                    Rectangle { horizontal-stretch: 3; min-width: 380px; VerticalLayout { spacing: 14px;
                        SectionTitle { text: "Benchmarks"; }
                        Text { text: "Select a category and benchmark to measure your hardware."; color: #8f9caf; font-size: 12px; wrap: word-wrap; }
                        Surface { height: 122px; vertical-stretch: 0; VerticalLayout { padding: 14px; spacing: 8px;
                            Label { text: "BENCHMARK CATEGORY"; }
                            HorizontalLayout { spacing: 7px; Button { text: "CPU bandwidth"; primary: root.suite-description == "Read, write, and copy bandwidth with per-operation sample statistics."; clicked => { root.select-suite("cpu.bandwidth"); } } Button { text: "CPU performance"; primary: root.suite-description == "Aggregate processor throughput, single-thread INT64, and compute-vs-memory diagnosis."; clicked => { root.select-suite("cpu.performance"); } } }
                            HorizontalLayout { spacing: 7px; Button { text: "GPU bandwidth"; primary: root.suite-description == "Estimated cache, GPU-local memory, and host-device bandwidth."; clicked => { root.select-suite("gpu.bandwidth"); } } Button { text: "GPU performance"; primary: root.suite-description == "Register throughput, working-set scaling, and capability-gated matrix performance."; clicked => { root.select-suite("gpu.performance"); } } }
                        } }
                        Text { text: root.suite-description; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                        benchmarks-scroll := ScrollView { vertical-stretch: 1; viewport-width: self.width; VerticalLayout { width: benchmarks-scroll.visible-width - 16px; spacing: 9px; alignment: start;
                            for benchmark in root.benchmarks: Surface {
                                height: max(104px, workload-content.preferred-height + 28px); vertical-stretch: 0; clip: true;
                                background: benchmark.selected ? #172e3b : workload-click.has-hover && benchmark.enabled ? #1a2330 : #151b26;
                                border-color: benchmark.selected ? #4d91df : #293448;
                                opacity: benchmark.enabled ? 1 : 0.62;
                                HorizontalLayout { padding: 14px; spacing: 14px;
                                    Rectangle { width: 4px; background: benchmark.selected ? #65d9ba : #40506a; border-radius: 2px; }
                                    workload-content := VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                                        Text { text: benchmark.name; color: #f4f7fb; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                                        Text { text: benchmark.data-type; color: #78a9ff; font-size: 11px; font-weight: 700; wrap: word-wrap; }
                                        Text { text: benchmark.workload; color: #adbacb; font-size: 11px; wrap: word-wrap; }
                                        Text { text: benchmark.enabled ? benchmark.unit : (benchmark.hardware-ready ? benchmark.availability : "Unavailable: " + benchmark.availability); color: benchmark.enabled ? #65d9ba : #f3ba67; font-size: 10px; wrap: word-wrap; }
                                    }
                                }
                                workload-click := TouchArea { width: parent.width; height: parent.height; enabled: benchmark.enabled && !root.running; mouse-cursor: pointer; clicked => { root.lab-details-expanded = false; root.select-benchmark(benchmark.id); } }
                            }
                        } }
                    } }
                    Surface { horizontal-stretch: 2; min-width: 300px; VerticalLayout { padding: 18px; spacing: 14px;
                        configuration-scroll := ScrollView { viewport-width: self.width; vertical-stretch: 1;
                            viewport-height: max(self.visible-height, configuration-content.preferred-height);
                            configuration-content := VerticalLayout { width: configuration-scroll.visible-width - 16px; height: self.preferred-height; spacing: 12px; alignment: start;
                        Label { text: "BENCHMARK DETAILS"; } Text { text: root.selected-benchmark-name; color: #f4f7fb; font-size: 21px; font-weight: 700; wrap: word-wrap; }
                        Text { text: root.selected-benchmark-description; color: #9fabbd; font-size: 12px; wrap: word-wrap; }
                        Button { text: root.lab-details-expanded ? "▾ About this test" : "▸ About this test"; clicked => { root.lab-details-expanded = !root.lab-details-expanded; } }
                        if root.lab-details-expanded: lab-details-scroll := ScrollView { height: 130px; viewport-width: self.width; vertical-stretch: 0;
                            viewport-height: max(self.visible-height, lab-details-text.preferred-height + 12px);
                            lab-details-text := Text { width: lab-details-scroll.visible-width - 16px; height: self.preferred-height; text: root.selected-benchmark-details; color: #b8c6d7; font-size: 12px; wrap: word-wrap; }
                        }
                        Text { text: root.selected-benchmark-availability; color: root.selected-benchmark-enabled ? #65d9ba : #f3ba67; font-size: 11px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #293448; } Label { text: "TARGET HARDWARE"; }
                        if root.show-gpu-selector && root.gpu-adapters.length > 0: ComboBox { enabled: !root.running; model: root.gpu-adapters; current-value: root.selected-gpu-name; selected(value) => { root.select-gpu(self.current-index); } }
                        if !root.show-gpu-selector: Text { text: root.target-hardware-name; color: #f4f7fb; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                        Text { text: root.target-hardware-description; color: #8f9caf; font-size: 11px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #293448; }
                        Label { text: "RUN CONFIGURATION"; }
                        Text { text: root.test-configuration-summary; color: root.test-configuration-valid ? #a5bce0 : #f3ba67; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 8px; vertical-stretch: 0; CheckBox { text: ""; width: 22px; height: 22px; checked: root.test-override-enabled; enabled: !root.running && root.selected-benchmark-enabled; toggled => { root.toggle-test-override(self.checked); } } Text { text: "Override global settings for this test"; color: #dbe7f5; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; } }
                        if root.test-override-enabled: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                            Text { text: "Applies only to this test in this session. Turn off to use the current global defaults."; color: #8f9caf; font-size: 11px; wrap: word-wrap; }
                            if root.test-is-offload: VerticalLayout { spacing: 6px; vertical-stretch: 0; height: self.preferred-height;
                                Label { text: "INPUT / OUTPUT DATA IN SYSTEM RAM"; }
                                ComboBox { height: 36px; vertical-stretch: 0; model: ["50% system RAM", "75% system RAM", "100% system RAM"]; current-value: root.test-offload-name; enabled: !root.running; selected(value) => { root.select-test-configuration("offload", self.current-index); } }
                            }
                            if root.test-is-scaling: VerticalLayout { spacing: 6px; vertical-stretch: 0; height: self.preferred-height;
                                Label { text: "DATASET MODE"; }
                                ComboBox { height: 36px; vertical-stretch: 0; model: ["Automatic (allocation budget)", "Sweep up to chosen size", "Test one chosen size"]; current-value: root.test-dataset-mode; enabled: !root.running; selected(value) => { root.select-test-configuration("dataset", self.current-index); } }
                                Label { text: "DATASET SIZE · MiB"; }
                                LineEdit { height: 36px; vertical-stretch: 0; text: root.test-dataset-text; enabled: !root.running && root.test-dataset-custom; edited => { root.edit-test-dataset(self.text); } }
                                Text { text: "MiB uses binary units; 1024 MiB = 1 GiB. Actual sizes follow buffer alignment or matrix shape. A size above the allocation budget needs a smaller dataset or larger budget."; color: #8f9caf; font-size: 11px; wrap: word-wrap; }
                            }
                            if root.test-is-cpu: VerticalLayout { spacing: 6px; vertical-stretch: 0; height: self.preferred-height;
                                Label { text: "CPU WORKER ALLOCATION"; }
                                ComboBox { height: 36px; vertical-stretch: 0; model: ["Gentle · 50%", "Balanced · 75%", "Full · 100%"]; current-value: root.test-cpu-name; enabled: !root.running; selected(value) => { root.select-test-configuration("cpu", self.current-index); } }
                                Label { text: "CPU PHYSICAL CORES"; }
                                ComboBox { height: 36px; vertical-stretch: 0; model: root.cpu-core-options; current-value: root.test-core-name; enabled: !root.running; selected(value) => { root.select-test-configuration("cores", self.current-index); } }
                                Text { text: "An exact count overrides the worker percentage; single-thread tests still use one worker."; color: #8f9caf; font-size: 11px; wrap: word-wrap; }
                            }
                            if root.test-is-gpu: VerticalLayout { spacing: 6px; vertical-stretch: 0; height: self.preferred-height;
                                Label { text: "GPU ACTIVITY"; }
                                ComboBox { height: 36px; vertical-stretch: 0; model: ["Gentle · 50%", "Balanced · 75%", "Full · 100%"]; current-value: root.test-gpu-name; enabled: !root.running; selected(value) => { root.select-test-configuration("gpu", self.current-index); } }
                            }
                            if root.test-has-ram: VerticalLayout { spacing: 6px; vertical-stretch: 0; height: self.preferred-height;
                                Label { text: "RAM ALLOCATION BUDGET"; }
                                ComboBox { height: 36px; vertical-stretch: 0; model: ["20% of RAM", "25% of RAM", "30% of RAM", "40% of RAM", "50% of RAM", "60% of RAM", "70% of RAM", "80% of RAM"]; current-value: root.test-ram-name; enabled: !root.running; selected(value) => { root.select-test-configuration("ram", self.current-index); } }
                            }
                            if root.test-is-gpu && root.test-is-scaling: VerticalLayout { spacing: 6px; vertical-stretch: 0; height: self.preferred-height;
                                Label { text: "VRAM ALLOCATION BUDGET"; }
                                ComboBox { height: 36px; vertical-stretch: 0; model: ["20% of VRAM", "25% of VRAM", "30% of VRAM", "40% of VRAM", "50% of VRAM", "60% of VRAM", "70% of VRAM", "80% of VRAM"]; current-value: root.test-vram-name; enabled: !root.running; selected(value) => { root.select-test-configuration("vram", self.current-index); } }
                            }


                        }
                        } }

                        if root.running: VerticalLayout { spacing: 10px; Label { text: "BENCHMARK IN PROGRESS"; color: #60e4c1; } Text { text: root.progress-message; color: #f4f7fb; font-size: 13px; wrap: word-wrap; } ProgressIndicator { progress: root.progress; } Text { text: root.queued-count > 0 ? "Queue: " + root.queued-count + " benchmark(s) remaining" : "Final benchmark in progress"; color: #9facbd; font-size: 11px; } Button { text: "Cancel benchmark"; clicked => { root.cancel(); } } }
                        if !root.running: VerticalLayout { spacing: 10px; Text { text: "5 repeated samples · configuration above applies to this test"; color: #8998ad; font-size: 11px; wrap: word-wrap; } Button { text: "Run benchmark"; primary: true; enabled: root.selected-benchmark-enabled && root.test-configuration-valid; clicked => { root.run-selected(); } } Button { text: "Run all in this category"; enabled: root.benchmarks.length > 0; clicked => { root.run-all(); } } }
                    } }
                }
                if root.page == 3: settings-scroll := ScrollView {
                    viewport-width: self.width;
                    viewport-height: max(self.visible-height, settings-content.preferred-height);
                    settings-content := VerticalLayout {
                    height: self.preferred-height; padding-bottom: 24px;
                    width: settings-scroll.visible-width - 16px; spacing: 16px; alignment: start;
                    SectionTitle { text: "Settings"; }
                    Text { text: "Global defaults apply to every test. On Benchmarks, enable an override to customize one selected test."; color: #8f9caf; font-size: 13px; wrap: word-wrap; }
                    Surface { height: max(260px, scaling-defaults.preferred-height + 36px); vertical-stretch: 0;
                        scaling-defaults := VerticalLayout { padding: 18px; spacing: 10px;
                            Text { text: "Scaling test defaults"; color: #f4f7fb; font-size: 17px; font-weight: 700; }
                            Label { text: "DATASET MODE · CPU AND GPU SCALING"; }
                            ComboBox { model: ["Automatic (allocation budget)", "Sweep up to chosen size", "Test one chosen size"]; current-value: root.default-dataset-mode; enabled: !root.running; selected(value) => { root.select-default-configuration("dataset", self.current-index); } }
                            Label { text: "DATASET SIZE · MiB"; }
                            LineEdit { text: root.default-dataset-text; enabled: !root.running && root.default-dataset-custom; edited => { root.edit-default-dataset(self.text); } }
                            if root.default-dataset-error != "": Text { text: root.default-dataset-error; color: #f3ba67; font-size: 12px; wrap: word-wrap; }
                            Text { text: "Automatic sweeps toward the allocation budget. Sweep tests growing datasets up to your chosen size. Test one chosen size measures a single dataset. 1024 MiB = 1 GiB. Actual sizes follow buffer alignment or matrix shape; oversized requests report the available limit. Fixed-size tests keep their workload-defined datasets."; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                            Label { text: "GPU RAM OFFLOAD · SHARE OF INPUT / OUTPUT DATA"; }
                            ComboBox { model: ["50% system RAM", "75% system RAM", "100% system RAM"]; current-value: root.default-offload-name; enabled: !root.running; selected(value) => { root.select-default-configuration("offload", self.current-index); } }
                            Text { text: "Applies to FP32 system-RAM offload scaling. The remainder uses VRAM; at 100%, all test arrays use system RAM. Allocation budgets below limit how much data can be tested."; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    Surface { height: max(190px, settings-panel-1.preferred-height + 36px); vertical-stretch: 0; settings-panel-1 := VerticalLayout { padding: 18px; spacing: 10px;
                        Text { text: "CPU worker allocation"; color: #f4f7fb; font-size: 17px; font-weight: 700; }
                        ComboBox { model: ["Gentle · 50%", "Balanced · 75%", "Full · 100%"]; current-value: root.cpu-intensity-name; enabled: !root.running; selected(value) => { root.select-cpu-intensity(self.current-index); } }
                        Text { text: "Limits the number of workers used by CPU compute, cache, and RAM tests. Reduced modes leave some workers free for other apps and allocate fewer cache-test buffers. Single-thread tests still use one worker; a single-core system cannot reserve a whole core."; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                    } }
                    Surface { height: max(190px, settings-panel-2.preferred-height + 36px); vertical-stretch: 0; settings-panel-2 := VerticalLayout { padding: 18px; spacing: 10px;
                        Text { text: "CPU physical cores"; color: #f4f7fb; font-size: 17px; font-weight: 700; }
                        ComboBox { model: root.cpu-core-options; current-value: root.cpu-core-name; enabled: !root.running; selected(value) => { root.select-cpu-cores(self.current-index); } }
                        Text { text: "Choose an exact number of physical cores for multithreaded CPU tests, with one worker per core. This overrides the percentage preset above. Automatic applies that preset to physical cores. Single-thread tests still use one worker. Fewer cores may ease contention and reduce heat or power use; retest to check throughput."; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                    } }
                    Surface { height: max(190px, settings-panel-3.preferred-height + 36px); vertical-stretch: 0; settings-panel-3 := VerticalLayout { padding: 18px; spacing: 10px;
                        Text { text: "Scaling test RAM budget"; color: #f4f7fb; font-size: 17px; font-weight: 700; }
                        ComboBox { model: ["20% of RAM", "25% of RAM", "30% of RAM", "40% of RAM", "50% of RAM", "60% of RAM", "70% of RAM", "80% of RAM"]; current-value: root.ram-budget-name; enabled: !root.running; selected(value) => { root.select-ram-budget(self.current-index); } }
                        Text { text: "Caps CPU vector/matrix buffers and the system-RAM region of GPU offload profiles, as a share of installed RAM. The test also caps allocation at 80% of currently available RAM and leaves at least 2 GiB available. Actual matrix sizes may be smaller. Larger budgets take longer and can reduce responsiveness. Cache and ordinary RAM bandwidth tests keep their own dataset sizes."; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                    } }
                    Surface { height: max(190px, settings-panel-4.preferred-height + 36px); vertical-stretch: 0; settings-panel-4 := VerticalLayout { padding: 18px; spacing: 10px;
                        Text { text: "GPU activity pacing"; color: #f4f7fb; font-size: 17px; font-weight: 700; }
                        ComboBox { model: ["Gentle · 50%", "Balanced · 75%", "Full · 100%"]; current-value: root.gpu-intensity-name; enabled: !root.running; selected(value) => { root.select-gpu-intensity(self.current-index); } }
                        Text { text: "Adds idle time between completed GPU work batches. Gentle waits about as long as the batch ran; Balanced adds about one-third as much idle time. These are activity targets, not exact utilization or power limits. GPU work can still reach full load during a burst."; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                    } }
                    Surface { height: max(190px, settings-panel-5.preferred-height + 36px); vertical-stretch: 0; settings-panel-5 := VerticalLayout { padding: 18px; spacing: 10px;
                        Text { text: "Scaling test VRAM budget"; color: #f4f7fb; font-size: 17px; font-weight: 700; }
                        ComboBox { model: ["20% of VRAM", "25% of VRAM", "30% of VRAM", "40% of VRAM", "50% of VRAM", "60% of VRAM", "70% of VRAM", "80% of VRAM"]; current-value: root.vram-budget-name; enabled: !root.running; selected(value) => { root.select-vram-budget(self.current-index); } }
                        Text { text: "Caps device-local test-buffer allocation for GPU FP32 and FP16 matrix scaling, including the VRAM region of RAM-offload profiles, with space reserved for outputs and allocation overhead. Both profiles sweep up to the selected budget. Larger budgets explore bigger data sets but leave less room for apps. Driver limits can lower the actual size; integrated matrix tests use an additional shared-memory cap."; color: #a7b4c5; font-size: 12px; wrap: word-wrap; }
                    } }
                    Surface { height: max(160px, settings-note.preferred-height + 32px); vertical-stretch: 0; background: #292318; border-color: #635239; settings-note := VerticalLayout { padding: 16px; spacing: 8px;
                        Label { text: "HOW THIS AFFECTS YOUR RESULTS"; color: #f3ba67; }
                        Text { text: "Reduced intensity can lower measured throughput and improve responsiveness. Each result records its intensity; best measurements and saved comparisons use matching settings. Lower load can reduce heat, but it cannot guarantee safe temperatures or prevent crashes. Settings apply to the next test and are locked while testing."; color: #d5c8b1; font-size: 12px; wrap: word-wrap; }
                    } }
                    Text { text: root.settings-status; color: #8f9caf; font-size: 11px; wrap: word-wrap; }
                    }
                }
                if root.page == 2: results-scroll := ScrollView {
                    viewport-width: self.width;
                    viewport-height: max(self.visible-height, results-content.preferred-height);
                    results-content := VerticalLayout {
                    width: results-scroll.visible-width - 16px;
                    height: self.preferred-height;
                    padding-bottom: 24px; spacing: 14px; alignment: start;
                    HorizontalLayout { height: 58px; vertical-stretch: 0;
                        VerticalLayout { spacing: 4px; SectionTitle { text: "Benchmark Results"; } Text { text: "Latest and best measurements by workload • " + root.result-count + " completed runs"; color: #8f9caf; font-size: 12px; } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { width: 116px; height: 34px; vertical-stretch: 0; text: "Clear view"; enabled: root.result-count > 0; clicked => { root.clear-results(); } }
                    }
                    if root.result-count == 0: Surface { height: 190px; vertical-stretch: 0;
                        VerticalLayout { padding: 24px; spacing: 12px;
                            Text { text: "No measurements yet"; color: #f4f7fb; font-size: 22px; font-weight: 700; }
                            Text { text: "Run benchmarks to measure your CPU and graphics card. System memory results appear with the CPU."; color: #9facbd; font-size: 13px; wrap: word-wrap; }
                            Button { width: 150px; height: 36px; text: "Open Benchmarks"; primary: true; clicked => { root.select-page(1); } }
                        }
                    }
                    if root.result-count > 0: HorizontalLayout { height: 40px; vertical-stretch: 0; spacing: 12px;
                        Label { text: "COMPONENT"; vertical-alignment: center; }
                        ComboBox { horizontal-stretch: 1; model: root.result-components; current-value: root.result-component-name; selected(value) => { root.select-result-component(self.current-index); } }
                        if root.result-has-bandwidth: Button { text: root.bandwidth-mode == 2 ? "Memory: Change" : root.bandwidth-mode == 1 ? "Memory: Best" : "Memory: Latest"; clicked => { root.bandwidth-mode = mod(root.bandwidth-mode + 1, 3); } }
                    }
                    if root.result-count > 0: HorizontalLayout { height: 40px; vertical-stretch: 0; spacing: 10px;
                        Label { text: "COMPARE WITH"; vertical-alignment: center; }
                        ComboBox { horizontal-stretch: 1; model: root.comparison-options; current-value: root.comparison-name; selected(value) => { root.select-comparison(self.current-index); } }
                    }
                    if root.result-count > 0: summary-table := Surface {
                        height: max(280px, root.result-summaries.length * 29px + root.result-header-count * 31px + 20px);
                        vertical-stretch: 0;
                        VerticalLayout { padding: 10px; spacing: 3px; alignment: start;
                            for row[index] in root.result-summaries: VerticalLayout {
                                spacing: 3px; vertical-stretch: 0;
                                if index == 0 || root.result-summaries[index - 1].section != row.section: HorizontalLayout {
                                    height: 28px; vertical-stretch: 0; spacing: 12px;
                                    Label { text: row.bandwidth ? (root.bandwidth-mode == 2 ? "MEMORY / CHANGE" : root.bandwidth-mode == 1 ? "MEMORY / BEST" : "MEMORY / LATEST") : (row.section == 1 ? "CACHE & TRANSFERS" : "COMPUTE"); horizontal-stretch: 1; }
                                    if row.bandwidth: Label { text: "READ"; width: 80px; horizontal-alignment: right; }
                                    if row.bandwidth: Label { text: "WRITE"; width: 80px; horizontal-alignment: right; }
                                    if row.bandwidth: Label { text: "COPY"; width: 80px; horizontal-alignment: right; }
                                    if !row.bandwidth: Label { text: "LATEST"; width: 100px; horizontal-alignment: right; }
                                    if !row.bandwidth: Label { text: "BEST"; width: 100px; horizontal-alignment: right; }
                                    if !row.bandwidth: Label { text: "CHANGE"; width: 64px; horizontal-alignment: right; }
                                    Label { text: "RUNS"; width: 38px; horizontal-alignment: right; }
                                }
                                Rectangle {
                                    height: 26px; vertical-stretch: 0; border-radius: 5px;
                                    background: root.result-selection == index ? #20364a : row-touch.has-hover ? #1b2838 : #111722;
                                    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 12px;
                                        Text { text: row.title; color: #e2e9f2; font-size: 11px; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                        if row.bandwidth: Text { text: root.bandwidth-mode == 2 ? row.read-delta : root.bandwidth-mode == 1 ? row.read-best : row.read-latest; color: root.bandwidth-mode == 1 ? #70e4cc : #dbe3ee; font-size: 11px; width: 80px; horizontal-alignment: right; vertical-alignment: center; }
                                        if row.bandwidth: Text { text: root.bandwidth-mode == 2 ? row.write-delta : root.bandwidth-mode == 1 ? row.write-best : row.write-latest; color: root.bandwidth-mode == 1 ? #70e4cc : #dbe3ee; font-size: 11px; width: 80px; horizontal-alignment: right; vertical-alignment: center; }
                                        if row.bandwidth: Text { text: root.bandwidth-mode == 2 ? row.copy-delta : root.bandwidth-mode == 1 ? row.copy-best : row.copy-latest; color: root.bandwidth-mode == 1 ? #70e4cc : #dbe3ee; font-size: 11px; width: 80px; horizontal-alignment: right; vertical-alignment: center; }
                                        if !row.bandwidth: Text { text: row.latest; color: #dbe3ee; font-size: 12px; width: 100px; horizontal-alignment: right; vertical-alignment: center; }
                                        if !row.bandwidth: Text { text: row.best; color: #70e4cc; font-size: 12px; width: 100px; horizontal-alignment: right; vertical-alignment: center; }
                                        if !row.bandwidth: Text { text: row.delta; color: #a5bce0; font-size: 11px; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: row.runs; color: #8f9caf; font-size: 11px; width: 38px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.tuning-details-expanded = false; root.tuning-notes-expanded = false; root.profile-selection = -1; root.profile-raw-expanded = false; root.select-result-row(index); } }
                                }
                            }
                        }
                    }
                    if root.result-count > 0: Surface {
                        height: max(root.result-details-expanded ? 540px : 220px, context-content.preferred-height + 56px);
                        vertical-stretch: 0; background: #142331; border-color: #315d7a;
                        VerticalLayout { padding: 12px; spacing: 6px; alignment: start;
                            HorizontalLayout { height: 26px; vertical-stretch: 0;
                                Label { text: "LATEST MEASUREMENT"; color: #73dcca; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.selected-result.sample-count + " • " + root.selected-result.elapsed; color: #8f9caf; font-size: 10px; vertical-alignment: center; }
                            }
                                context-content := VerticalLayout { height: self.preferred-height; vertical-stretch: 0; padding-bottom: 12px; spacing: 6px; alignment: start;
                                    Text { text: root.selected-result.title; color: #dbe3ee; font-size: 12px; font-weight: 600; wrap: word-wrap; }
                                    Text { text: root.selected-result.description-tldr; color: #c2cede; font-size: 12px; wrap: word-wrap; }
                                    Text { text: root.comparison-note; color: #a5bce0; font-size: 11px; wrap: word-wrap; }
                                    Text { text: root.selected-result.summary; color: #73dcca; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                                    Button { text: root.result-details-expanded ? "▾ Benchmark details & measurements" : "▸ Benchmark details & measurements"; clicked => { root.toggle-result-details(); } }
                                    if root.result-details-expanded: measurement-row := HorizontalLayout { spacing: 10px; vertical-stretch: 0;
                                        for fact in root.selected-result.measurement-facts: Rectangle { width: (measurement-row.width - 20px) / 3; height: max(110px, measurement-card.preferred-height + 24px); vertical-stretch: 0; background: #10242b; border-radius: 9px;
                                            measurement-card := VerticalLayout { padding: 12px; spacing: 7px; alignment: start;
                                                Text { text: fact.label; color: #91b8c3; font-size: 11px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.value; color: fact.accent; font-size: 19px; font-weight: 700; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.detail; color: #a5bec6; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                                            }
                                        }
                                    }
                                    if root.result-details-expanded && root.selected-result.measurement-bars.length > 0: Label { text: "MEASURED SAMPLE SPREAD"; color: #73dcca; }
                                    if root.result-details-expanded: VerticalLayout { spacing: 8px; height: self.preferred-height; vertical-stretch: 0;
                                        for bar in root.selected-result.measurement-bars: VerticalLayout { spacing: 4px; height: self.preferred-height; vertical-stretch: 0;
                                            HorizontalLayout { Text { text: bar.label; color: #bdcdd2; font-size: 12px; } Text { text: bar.value; color: #78a9ff; font-size: 13px; horizontal-alignment: right; } }
                                            Rectangle { height: 12px; background: #0a1b23; border-radius: 4px; vertical-stretch: 0;
                                                Rectangle { x: 0px; y: 0px; width: parent.width * bar.ratio; height: parent.height; background: bar.accent; border-radius: 4px; }
                                            }
                                        }
                                    }
                                    if root.result-details-expanded && root.selected-result.measurement-bars.length > 0: Text { text: "Minimum, median and maximum across repeated samples, on one scale. These describe throughput variation within this run."; color: #9db1c8; font-size: 11px; wrap: word-wrap; }
                                    if root.result-details-expanded: context-row := HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                        for fact in root.selected-result.context-facts: Rectangle { width: (context-row.width - 24px) / 4; height: max(80px, context-card.preferred-height + 20px); vertical-stretch: 0; background: #1b3040; border-radius: 8px;
                                            context-card := VerticalLayout { padding: 10px; spacing: 6px; alignment: start;
                                                Text { text: fact.label; color: #91b8c3; font-size: 10px; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.value; color: #dbe3ee; font-size: 13px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
                                            }
                                        }
                                    }
                                    if root.result-details-expanded && root.selected-result.profile-sizes.length > 0: Label { text: "PERFORMANCE AS DATA GROWS"; color: #73dcca; }
                                    if root.result-details-expanded && root.selected-result.profile-sizes.length > 0: profile-interactive := InteractiveChart {
                                        chart: root.selected-result.profile-chart; labels: root.selected-result.profile-labels; points: root.selected-result.profile-points; source-height: 420;
                                        pick-point(x, y, width, height) => { return root.chart-point-at(root.selected-result.profile-points, x, y, width, height, 420); }
                                    }
                                    if root.result-details-expanded && root.selected-result.profile-sizes.length > 0: Text { text: "Points show median throughput; shading shows sample minimum–maximum. Dashed line: this run’s compute reference. Dataset sizes use a logarithmic scale."; color: #9db1c8; font-size: 11px; wrap: word-wrap; }
                                    if root.result-details-expanded && root.selected-result.profile-sizes.length > 0: ComboBox { model: root.selected-result.profile-sizes; current-index: root.profile-index; selected(value) => { root.profile-selection = self.current-index; } }
                                    if root.result-details-expanded && root.selected-result.profile-sizes.length > 0: Text { text: root.selected-result.profile-statistics[root.profile-index]; color: #c2cede; font-size: 11px; wrap: word-wrap; }
                                    if root.result-details-expanded && root.selected-result.gpu-timing-visible: Label { text: "MEASURED GPU TIMINGS · LOWER IS FASTER"; color: #edc778; }
                                    if root.result-details-expanded && root.selected-result.gpu-timing-available: timing-interactive := InteractiveChart {
                                        chart: root.selected-result.gpu-timing-chart; labels: root.selected-result.gpu-timing-labels; points: root.selected-result.gpu-timing-points; source-height: 280;
                                        pick-point(x, y, width, height) => { return root.chart-point-at(root.selected-result.gpu-timing-points, x, y, width, height, 280); }
                                    }
                                    if root.result-details-expanded && root.selected-result.gpu-timing-visible: Text { text: root.selected-result.gpu-timing-note; color: #9db1c8; font-size: 11px; wrap: word-wrap; }
                                    if root.result-details-expanded: Label { text: "WHAT THIS TEST MEASURES"; }
                                    if root.result-details-expanded: Text { text: root.selected-result.description; color: #c2cede; font-size: 12px; wrap: word-wrap; }
                                    if root.result-details-expanded: Label { text: "WHERE IT CAN HELP"; }
                                    if root.result-details-expanded: Text { text: root.selected-result.everyday-use; color: #c2cede; font-size: 12px; wrap: word-wrap; }
                                    if root.result-details-expanded: Label { text: "HOW TO READ THE METRICS"; }
                                    if root.result-details-expanded: Text { text: root.selected-result.metric-guide; color: #9db1c8; font-size: 11px; wrap: word-wrap; }
                                    if root.result-details-expanded: Text { text: root.selected-result.diagnosis; color: #b9c7d8; font-size: 12px; wrap: word-wrap; }
                                    if root.result-details-expanded: Button { text: root.profile-raw-expanded ? "▾ Raw measurements & metadata" : "▸ Raw measurements & metadata"; clicked => { root.profile-raw-expanded = !root.profile-raw-expanded; } }
                                    if root.result-details-expanded && root.profile-raw-expanded: Text { text: root.selected-result.details; color: #8f9caf; font-size: 11px; wrap: word-wrap; }
                                }
                        }
                    }
                    if root.selected-result.tuning-guidance != "" && root.result-count > 0: Surface {
                        background: #172c32; border-color: #4aa99a;
                        height: max(root.tuning-details-expanded ? 300px : 180px, tuning-content.preferred-height + 48px);
                        vertical-stretch: 0;
                        VerticalLayout { padding: 12px; spacing: 6px; alignment: start;
                            Text { text: root.selected-result.tuning-title; color: #83efda; font-size: 14px; font-weight: 700; }
                                tuning-content := VerticalLayout { height: self.preferred-height; vertical-stretch: 0; padding-bottom: 12px; spacing: 8px; alignment: start;
                                    Text { text: root.selected-result.tuning-tldr; color: #dbe8ee; font-size: 12px; font-weight: 600; wrap: word-wrap; }
                                    if !root.tuning-details-expanded && root.selected-result.memory-pressure != "": Text { text: root.selected-result.memory-pressure; color: #a5d9d1; font-size: 11px; wrap: word-wrap; }
                                    Button { text: root.tuning-details-expanded ? "▾ Hide visual breakdown" : "▸ Show visual breakdown"; clicked => { root.tuning-details-expanded = !root.tuning-details-expanded; root.tuning-notes-expanded = false; } }
                                    if root.tuning-details-expanded: VerticalLayout { spacing: 12px; height: self.preferred-height; vertical-stretch: 0; alignment: start;
                                    tuning-top-row := HorizontalLayout { spacing: 10px; vertical-stretch: 0;
                                        for fact in root.selected-result.tuning-facts-top: Rectangle { width: (tuning-top-row.width - 20px) / 3; horizontal-stretch: 0; vertical-stretch: 0; height: max(118px, tuning-top-content.preferred-height + 24px); background: #10242b; border-radius: 9px;
                                            tuning-top-content := VerticalLayout { padding: 12px; spacing: 7px; alignment: start;
                                                Text { text: fact.label; color: #91b8c3; font-size: 11px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.value; color: fact.accent; font-size: 20px; font-weight: 700; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.detail; color: #a5bec6; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                                            }
                                        }
                                    }
                                    tuning-bottom-row := HorizontalLayout { spacing: 10px; vertical-stretch: 0;
                                        for fact in root.selected-result.tuning-facts-bottom: Rectangle { width: (tuning-bottom-row.width - 20px) / 3; horizontal-stretch: 0; vertical-stretch: 0; height: max(118px, tuning-bottom-content.preferred-height + 24px); background: #10242b; border-radius: 9px;
                                            tuning-bottom-content := VerticalLayout { padding: 12px; spacing: 7px; alignment: start;
                                                Text { text: fact.label; color: #91b8c3; font-size: 11px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.value; color: fact.accent; font-size: 20px; font-weight: 700; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.detail; color: #a5bec6; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                                            }
                                        }
                                    }
                                    if root.selected-result.tuning-quality != "": Rectangle { height: max(54px, quality-text.preferred-height + 24px); vertical-stretch: 0; background: #303026; border-radius: 8px;
                                        quality-text := Text { x: 12px; y: 12px; width: parent.width - 24px; height: self.preferred-height; text: root.selected-result.tuning-quality; color: #edc778; font-size: 12px; wrap: word-wrap; }
                                    }
                                    if root.selected-result.tuning-bars.length > 0: Label { text: "THROUGHPUT COMPARISON"; color: #83efda; }
                                    for bar in root.selected-result.tuning-bars: VerticalLayout { spacing: 5px; height: self.preferred-height; vertical-stretch: 0;
                                        HorizontalLayout { vertical-stretch: 0; Text { text: bar.label; color: #bdcdd2; font-size: 12px; wrap: word-wrap; } Text { text: bar.value; color: bar.accent; font-size: 13px; font-weight: 700; horizontal-alignment: right; } }
                                        rate-track := Rectangle { height: 16px; vertical-stretch: 0; background: #0a1b23; border-radius: 5px; clip: true;
                                            Rectangle { x: 0px; y: 0px; width: parent.width * bar.ratio; height: parent.height; background: bar.accent; border-radius: 5px; }
                                            if bar.range-visible: Rectangle { x: parent.width * bar.minimum; y: 7px; width: max(2px, parent.width * (bar.maximum - bar.minimum)); height: 2px; background: #e6f4f2; }
                                        }
                                    }
                                    if root.selected-result.tuning-bars.length > 0: Text { text: "Each bar shows measured throughput on the same scale; thin markers show sample minimum–maximum. This is a performance comparison."; color: #91aeb8; font-size: 11px; wrap: word-wrap; }
                                    if root.selected-result.tuning-allocation.length > 0: Label { text: "TEST BUFFER ALLOCATION"; color: #83efda; }
                                    for bar in root.selected-result.tuning-allocation: VerticalLayout { spacing: 5px; height: self.preferred-height; vertical-stretch: 0;
                                        Text { text: bar.label; color: #bdcdd2; font-size: 12px; }
                                        Text { text: bar.value; color: bar.accent; font-size: 13px; wrap: word-wrap; }
                                        Rectangle { height: 14px; vertical-stretch: 0; background: #0a1b23; border-radius: 5px; clip: true;
                                            Rectangle { x: 0px; y: 0px; width: parent.width * bar.ratio; height: parent.height; background: bar.accent; border-radius: 5px; }
                                        }
                                    }
                                    if root.selected-result.tuning-actions.length > 0: Label { text: "RETEST CHECKLIST"; color: #83efda; }
                                    tuning-action-row := HorizontalLayout { spacing: 10px; vertical-stretch: 0;
                                        for action in root.selected-result.tuning-actions: Rectangle { width: (tuning-action-row.width - 20px) / 3; horizontal-stretch: 0; vertical-stretch: 0; height: max(154px, action-content.preferred-height + 24px); background: #10242b; border-radius: 9px;
                                            action-content := VerticalLayout { padding: 12px; spacing: 8px; alignment: start;
                                                Text { text: action.label; color: action.accent; font-size: 11px; font-weight: 700; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: action.value; color: #dbe8ee; font-size: 13px; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: action.detail; color: #91aeb8; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                                            }
                                        }
                                    }
                                    Button { text: root.tuning-notes-expanded ? "▾ Hide technical notes" : "▸ Technical notes and full reasoning"; clicked => { root.tuning-notes-expanded = !root.tuning-notes-expanded; } }
                                    if root.tuning-notes-expanded: Text { text: root.selected-result.tuning-stats; color: #a5d9d1; font-size: 11px; wrap: word-wrap; }
                                    if root.tuning-notes-expanded: Text { text: root.selected-result.tuning-guidance; color: #dbe8ee; font-size: 12px; wrap: word-wrap; }
                                    if root.tuning-notes-expanded: Text { text: "Trial suggestions are relative to your current setup. Power and temperatures after a change are not measured."; color: #9db9bd; font-size: 11px; wrap: word-wrap; }
                                    }

                                }
                        }
                    }
                    if root.result-count > 0: Text { height: max(24px, self.preferred-height); vertical-stretch: 0; text: "Change compares with the selected saved setup. + means higher throughput; — means no comparable metric."; color: #71809a; font-size: 10px; wrap: word-wrap; }
                    Text { height: max(20px, self.preferred-height); text: root.results-file-status; color: #8f9caf; font-size: 10px; wrap: word-wrap; vertical-stretch: 0; }
                    }
                }
            }
        }
    }
    // Keep the stop action accessible on every page, outside scrolling content.
    if root.running: Surface {
        x: 22px;
        y: root.height - self.height - 136px;
        width: 198px; height: 140px;
        background: #291c29; border-color: #d67888;
        VerticalLayout { padding: 14px; spacing: 8px;
            HorizontalLayout {
                Label { text: "TEST RUNNING"; color: #ffb5c1; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.queued-count + " queued"; color: #b7a1b3; font-size: 10px; }
            }
            Text { text: root.progress-message; color: #e4d4e3; font-size: 11px; overflow: elide; }
            ProgressIndicator { progress: root.progress; height: 6px; vertical-stretch: 0; }
            Button {
                text: root.status == "Cancelling benchmark…" ? "Stopping…" : "Stop all tests";
                enabled: root.status != "Cancelling benchmark…";
                height: 38px; vertical-stretch: 0;
                clicked => { root.cancel(); }
            }
        }
    }
}
