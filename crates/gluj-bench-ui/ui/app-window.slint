import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct DeviceFact { label: string, value: string, }
export struct DeviceRow {
    id: string, name: string, category: string, availability: string, status: string,
    details: string, cache-details: string, accent: color, available: bool,
    description: string, facts: [DeviceFact], badges: [string], technical: [DeviceFact], topology: [DeviceFact], support: [DeviceFact],
}
export struct BenchmarkRow {
    id: string, name: string, workload: string, availability: string, data-type: string,
    unit: string, enabled: bool, selected: bool, hardware-ready: bool,
}
export struct ChartLabel { x: float, y: float, width: float, text: string, font-size: float, accent: color, alignment: int, }
export struct ChartPoint { x: float, y: float, bottom: float, value-label: string, x-label: string, series: string, display-value: string, context: string, accent: color, }
struct ChartArea { left: float, right: float, top: float, bottom: float, }
export global ChartInteraction {
    pure callback point-at([ChartPoint], float, float, float, float, float) -> int;
    in property <bool> clipboard-available;
    callback copy-value(string) -> bool;
}
export struct TuningFact { label: string, value: string, detail: string, accent: color, }
export struct TuningBar { label: string, value: string, ratio: float, minimum: float, maximum: float, range-visible: bool, accent: color, }
export struct ComputeBalance { visible: bool, has-loss: bool, delay: string, delay-warning: bool, reference: string, settled: string, loss: string, note: string, retained-ratio: float, reference-ratio: float, loss-ratio: float, }
export struct DatasetMeasurement { facts: [DeviceFact], samples: [DeviceFact], }
export struct ResultRow {
    recorded-at: string, is-new: bool,
    compute-balance: ComputeBalance,
    memory-measurements: [DeviceFact], measurement-facts: [TuningFact], measurement-bars: [TuningBar], context-facts: [DeviceFact],
    title: string, device: string, elapsed: string, primary-name: string,
    primary-value: string, sample-count: string,
    fact-one-label: string, fact-one-value: string, fact-two-label: string, fact-two-value: string,
    fact-three-label: string, fact-three-value: string, fact-four-label: string, fact-four-value: string,
    summary: string, diagnosis: string, description: string, description-tldr: string, everyday-use: string, metric-guide: string, tuning-guidance: string, tuning-tldr: string, tuning-stats: string, memory-pressure: string, tuning-title: string, tuning-goal: string,
    profile-chart: image, profile-labels: [ChartLabel], profile-points: [ChartPoint], profile-sizes: [string], profile-measurements: [DatasetMeasurement],
    throughput-chart: image, throughput-labels: [ChartLabel], throughput-points: [ChartPoint], dataset-loss: string,
    gpu-timing-title: string, gpu-timing-height: float, gpu-timing-chart: image, gpu-timing-labels: [ChartLabel], gpu-timing-points: [ChartPoint], gpu-timing-available: bool, gpu-timing-visible: bool, gpu-timing-note: string,
    tuning-quality: string,
}

export struct SnapshotChoice { title: string, detail: string, selected: bool, }

export struct DatasetRow { size: string, operation: string, median: string, range: string, count: string, }
export struct HistoryRow { id: string, name: string, date: string, status: string, source: string, observations: string, checked: bool, }
struct HistoryMenuItem { label: string, action: string, enabled: bool, }
export struct ObservationRow { sequence: string, value: string, offset: string, active: string, elapsed: string, status: string, scope: string, realization: string, }
export struct ObservationView {
    series: [string], realizations: [string], series-index: int, realization-index: int,
    rows: [ObservationRow], chart: image, chart-points: [ChartPoint], chart-visible: bool, message: string,
    has-previous: bool, has-next: bool, loading: bool,
}
export struct ConditionRow { included: bool, expanded: bool, details: [DeviceFact], index: int, group: string, title: string, mode: string, dataset: string, workers: string, target: string, status: string, action: string, }
component MeasureText inherits Text { font-family: Theme.numeric-font; color: Theme.body; }
component FactRows inherits VerticalLayout {
    height: self.preferred-height; vertical-stretch: 0;
    in property <[DeviceFact]> rows;
    spacing: 8px;
    for fact in root.rows: HorizontalLayout {
        spacing: 12px; vertical-stretch: 0;
        Text { text: fact.label; color: Theme.muted; font-size: 12px; horizontal-stretch: 1; wrap: word-wrap; }
        MeasureText { text: fact.value; color: Theme.body; font-size: 12px; horizontal-stretch: 2; horizontal-alignment: right; wrap: word-wrap; }
    }
}
export struct TemplateRow { id: string, title: string, detail: string, group: string, coverage: string, duration: string, }
export struct SummaryRow { recorded-at: string, is-new: bool, typical: string, read-typical: string, write-typical: string, copy-typical: string, title: string, configuration: string, metric: string, latest: string, best: string, runs: string, section: int, bandwidth: bool, read-latest: string, write-latest: string, copy-latest: string, read-best: string, write-best: string, copy-best: string, delta: string, read-delta: string, write-delta: string, copy-delta: string, }

component ActionButton inherits Button { height: 32px; vertical-stretch: 0; min-width: 0px; }
component ChoiceButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> left-aligned;
    callback clicked;
    height: 32px; vertical-stretch: 0;
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
    border-radius: 4px;
    background: pointer.pressed ? Theme.inset : pointer.has-hover ? Theme.hover : root.selected ? Theme.selection : root.left-aligned ? transparent : Theme.inset;
    border-width: root.selected || focus.has-focus ? 1px : 0px;
    border-color: focus.has-focus ? Theme.brass : Theme.selection-border;
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.text;
    accessible-action-default => { pointer.clicked(); }
    Text {
        x: 12px; width: max(0px, parent.width - 24px);
        text: root.text; color: !root.enabled ? Theme.quiet : root.selected ? Theme.text : Theme.muted;
        font-size: 12px; font-weight: root.selected ? 600 : 400;
        horizontal-alignment: root.left-aligned ? left : center;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: root.left-aligned ? 0px : 8px;
        y: root.left-aligned ? 8px : parent.height - 2px;
        width: root.left-aligned ? 2px : parent.width - 16px;
        height: root.left-aligned ? parent.height - 16px : 2px;
        background: root.selected ? Theme.brass : transparent;
    }
    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if root.enabled {
                focus.focus();
                root.clicked();
            }
        }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                pointer.clicked();
                return accept;
            }
            return reject;
        }
    }
}
component NewBadge inherits Rectangle {
    in property <bool> fresh;
    width: 32px; height: 16px; vertical-stretch: 0;
    Text { text: root.fresh ? "New" : ""; color: Theme.success; font-size: 11px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
}
component Picker inherits ComboBox { height: 36px; vertical-stretch: 0; min-width: 0px; }
component Input inherits LineEdit { height: 36px; vertical-stretch: 0; min-width: 0px; }
component SectionTitle inherits Text { color: Theme.text; font-size: 24px; font-weight: 600; }
component Surface inherits Rectangle { background: Theme.surface; border-color: Theme.border; border-width: 1px; border-radius: 4px; }
component Label inherits Text { color: Theme.muted; font-size: 12px; font-weight: 500; }
component PlanReadout inherits VerticalLayout {
    in property <[DeviceFact]> rows;
    spacing: 4px; vertical-stretch: 0; height: self.preferred-height;
    for fact[index] in root.rows: HorizontalLayout {
        height: 20px; vertical-stretch: 0; spacing: 8px;
        Text { text: index == 0 ? "Tests" : index == 1 ? "Minimum time" : fact.label == "Known buffer estimate · partial" ? "Buffers (partial)" : "Peak buffers"; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; overflow: elide; vertical-alignment: center; }
        MeasureText { text: fact.value == "Resolves at execution" ? "At runtime" : fact.value; width: 144px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }
}
component SettingsRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    spacing: 16px;
    vertical-stretch: 0;
    VerticalLayout {
        horizontal-stretch: 1; alignment: center; spacing: 2px;
        Text { text: root.title; color: Theme.body; font-size: 13px; font-weight: 600; }
        if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
    }
    VerticalLayout { width: 264px; alignment: center; @children }
}
component SettingsGroup inherits Surface {
    in property <string> title;
    height: settings-group-content.preferred-height;
    vertical-stretch: 0;
    settings-group-content := VerticalLayout {
        padding: 12px; spacing: 8px;
        Label { text: root.title; }
        @children
    }
}
component HistoryMenu inherits Rectangle {
    in property <string> label;
    in property <[HistoryMenuItem]> items;
    callback choose(string);
    height: 36px;
    vertical-stretch: 0;
    ActionButton { width: parent.width; height: parent.height; text: root.label; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: root.width - self.width; y: root.height + 4px;
        width: 192px; height: menu-items.preferred-height + 12px;
        close-policy: close-on-click-outside;
        Surface { border-radius: 8px; }
        menu-items := VerticalLayout {
            padding: 6px;
            for item in root.items: VerticalLayout {
                if item.label != "": ActionButton {
                    text: item.label;
                    enabled: item.enabled;
                    clicked => { root.choose(item.action); menu.close(); }
                }
            }
        }
    }
}
component InteractiveChart inherits Rectangle {
    in property <image> chart;
    in property <[ChartLabel]> labels;
    in property <[ChartPoint]> points;
    in property <float> source-height;
    in property <ChartArea> plot;
    in property <ChartArea> second-plot;
    private property <float> cursor-x: pointer.mouse-x / root.width * 900;
    private property <float> cursor-y: pointer.mouse-y / root.height * root.source-height;
    pure function contains-guide(area: ChartArea) -> bool {
        return area.bottom > area.top && root.guide-x >= area.left && root.guide-x <= area.right && root.guide-y >= area.top && root.guide-y <= area.bottom;
    }
    private property <bool> guide-in-plot: root.contains-guide(root.plot);
    private property <bool> guide-in-second-plot: root.contains-guide(root.second-plot);
    private property <ChartArea> hovered-plot: root.guide-in-plot ? root.plot : root.guide-in-second-plot ? root.second-plot : {};
    private property <bool> over-plot: pointer.has-hover && root.points.length > 0 && root.hovered-plot.bottom > 0;
    private property <int> active: pointer.has-hover && root.points.length > 0 ? ChartInteraction.point-at(root.points, pointer.mouse-x / 1px, pointer.mouse-y / 1px, root.width / 1px, root.height / 1px, root.source-height) : -1;
    private property <ChartPoint> point: root.active >= 0 && root.active < root.points.length ? root.points[root.active] : {};
    private property <int> feedback-point: -1;
    private property <bool> copy-succeeded;
    private property <bool> show-copy-feedback: copy-feedback.running && root.active == root.feedback-point;
    changed points => { copy-feedback.stop(); }
    private property <float> guide-x: root.active >= 0 ? root.point.x : root.cursor-x;
    private property <float> guide-y: root.active >= 0 ? root.point.y : root.cursor-y;
    private property <float> guide-bottom: root.active >= 0 ? root.point.bottom : root.hovered-plot.bottom;
    private property <color> guide-color: root.active >= 0 ? root.point.accent : Theme.iris;
    height: self.width * root.source-height / 900;
    vertical-stretch: 0;
    Image { width: parent.width; height: parent.height; source: root.chart; image-fit: contain; }
    for label in root.labels: Text { x: root.width * label.x / 900; y: root.height * label.y / root.source-height; width: root.width * label.width / 900; height: max(22px, root.height * 22 / root.source-height); text: label.text; color: label.accent; font-size: max(11px, root.width * label.font-size / 900); horizontal-alignment: label.alignment == 0 ? left : label.alignment == 1 ? center : right; }
    if root.over-plot: Rectangle { x: root.width * root.hovered-plot.left / 900; y: root.height * root.guide-y / root.source-height; width: root.width * (root.guide-x - root.hovered-plot.left) / 900; height: 1px; background: root.guide-color; }
    if root.over-plot: Rectangle { x: root.width * root.guide-x / 900; y: root.height * root.guide-y / root.source-height; width: 1px; height: root.height * (root.guide-bottom - root.guide-y) / root.source-height; background: root.guide-color; }
    if root.active >= 0: Rectangle { x: root.width * root.point.x / 900 - 5px; y: root.height * root.point.y / root.source-height - 5px; width: 10px; height: 10px; border-radius: 5px; background: root.point.accent; border-width: 2px; border-color: Theme.text; }
    if root.active >= 0: Rectangle { x: 0px; y: max(0px, root.height * root.point.y / root.source-height - 11px); width: root.width * (root.hovered-plot.left - 2) / 900; height: 22px; background: Theme.selection; border-radius: 3px;
        Text { text: root.point.value-label; color: root.point.accent; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
    }
    if root.active >= 0: Rectangle { x: clamp(root.width * root.point.x / 900 - 75px, 0px, root.width - 150px); y: root.height * root.point.bottom / root.source-height + 4px; width: 150px; height: 23px; background: Theme.selection; border-radius: 3px;
        Text { text: root.point.x-label; color: root.point.accent; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.active >= 0: tooltip := Rectangle { width: min(260px, root.width - 120px); height: tooltip-content.preferred-height; x: clamp(root.width * root.point.x / 900 + 12px, 80px, root.width - self.width - 8px); y: clamp(root.height * root.point.y / root.source-height - self.height - 12px, 4px, root.height - self.height - 4px); background: Theme.selection; border-width: 1px; border-color: root.point.accent; border-radius: 4px;
        tooltip-content := VerticalLayout { padding: 12px; spacing: 8px; alignment: start;
            Text { text: root.point.series; color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
            Text { text: root.point.display-value; color: root.point.accent; font-size: 20px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
            Text { text: root.point.context; color: Theme.body; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
            if ChartInteraction.clipboard-available: Text {
                text: root.show-copy-feedback ? (root.copy-succeeded ? "Copied" : "Could not copy") : "Click to copy value";
                color: root.show-copy-feedback ? (root.copy-succeeded ? Theme.success : Theme.danger) : Theme.muted;
                font-size: 11px; vertical-stretch: 0;
            }
        }
    }
    copy-feedback := Timer { interval: 1200ms; running: false; triggered => { self.stop(); } }
    pointer := TouchArea {
        width: parent.width; height: parent.height; mouse-cursor: root.over-plot ? crosshair : default;
        clicked => {
            if ChartInteraction.clipboard-available && root.active >= 0 && root.point.display-value != "" {
                root.feedback-point = root.active;
                root.copy-succeeded = ChartInteraction.copy-value(root.point.display-value);
                copy-feedback.stop();
                copy-feedback.start();
            }
        }
    }
}
component ObservationPanel inherits VerticalLayout {
    in property <ObservationView> view;
    callback change(string, int);
    spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
    if root.view.series.length > 0: Picker { model: root.view.series; current-index: root.view.series-index; selected(value) => { root.change("series", self.current-index); } }
    if root.view.realizations.length > 1: Picker { model: root.view.realizations; current-index: root.view.realization-index; selected(value) => { root.change("realization", self.current-index); } }
    if root.view.chart-visible: InteractiveChart {
        chart: root.view.chart; points: root.view.chart-points; source-height: 240;
        plot: { left: 100, right: 820, top: 30, bottom: 180 };
    }
    Text { text: root.view.message; color: Theme.muted; wrap: word-wrap; }
    if root.view.rows.length > 0: HorizontalLayout { spacing: 8px; padding-right: 12px;
        Text { text: "# / Offset"; color: Theme.muted; horizontal-stretch: 1; }
        Text { text: "Measured value"; color: Theme.muted; horizontal-stretch: 2; }
        Text { text: "Active / elapsed"; color: Theme.muted; horizontal-stretch: 2; }
        Text { text: "Status"; color: Theme.muted; horizontal-stretch: 1; }
    }
    if root.view.rows.length > 0: table := ScrollView {
        private property <string> first-sequence: root.view.rows[0].sequence;
        height: min(216px, samples.preferred-height); vertical-stretch: 0;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, samples.preferred-height);
        samples := VerticalLayout { x: 0px; y: 0px; width: max(0px, table.width - 12px); height: self.preferred-height; spacing: 8px;
            for sample in root.view.rows: HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                Text { text: sample.sequence + " · " + sample.offset; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; wrap: word-wrap; }
                Text { text: sample.value; color: Theme.text; font-size: 12px; horizontal-stretch: 2; wrap: word-wrap; }
                Text { text: sample.active + " / " + sample.elapsed; color: Theme.muted; font-size: 11px; horizontal-stretch: 2; wrap: word-wrap; }
                Text { text: sample.status; color: Theme.brass; font-size: 11px; horizontal-stretch: 1; }
            }
        }
        changed first-sequence => { self.viewport-y = 0px; }
    }
    if root.view.has-previous || root.view.has-next: HorizontalLayout { spacing: 8px;
        ActionButton { text: "Previous"; enabled: root.view.has-previous; clicked => { root.change("previous", 0); } }
        ActionButton { text: "Next"; enabled: root.view.has-next; clicked => { root.change("next", 0); } }
    }
}
export component MainWindow inherits Window {
    title: "Gluj-Bench";
    in property <string> app-version;
    in property <bool> system-ready: false;
    icon: @image-url("icons/logo-256.png");
    min-width: 980px; min-height: 680px;
    preferred-width: 1280px; preferred-height: 820px;
    background: Theme.canvas;

    in-out property <int> page: 0;
    in property <string> default-dataset-mode;
    in property <string> default-dataset-text;
    in property <bool> default-dataset-custom;
    in property <string> default-dataset-error;
    in property <string> default-offload-name;
    callback select-default-configuration(string, int);
    callback edit-default-dataset(string);
    in-out property <bool> test-override-enabled;
    in-out property <length> configuration-scroll-offset: 0px;
    in property <string> configuration-test-id;
    in property <bool> test-is-cpu;
    in property <bool> test-is-gpu-vector;
    in property <bool> test-is-gpu-memory;
    in property <bool> test-is-transfer;
    in-out property <int> memory-operation-index;
    in-out property <int> memory-copy-index;
    in-out property <int> transfer-direction-index;
    in-out property <int> staging-buffers-index;
    in-out property <int> transfer-batch-index;
    in-out property <int> transfer-submission-index;
    in-out property <int> gpu-matrix-reuse-index;
    in-out property <int> gpu-matrix-traversal-index;
    in-out property <int> gpu-matrix-tile-index;
    in property <[string]> gpu-matrix-tile-names;
    in property <bool> test-is-gpu;
    in property <bool> test-is-gpu-matrix;
    in property <bool> test-is-gpu-int8-matrix;
    in property <bool> test-is-scaling;
    in property <bool> test-is-configurable-compute;
    in property <bool> test-is-matrix;
    in property <bool> test-is-ascii;
    in property <bool> test-is-int64;
    in-out property <int> test-vector-choice-index: 0;
    in property <bool> test-vector-can-reset;
    callback select-vector-choice(int);
    callback reset-vector-configuration();
    in property <bool> test-vector-legacy;
    in property <bool> test-vector-register;
    in property <bool> test-vector-custom;
    in-out property <int> test-vector-preset-index;
    in-out property <int> test-vector-mode-index;
    in property <string> test-vector-size;
    in property <string> test-vector-preview;
    in-out property <float> test-vector-size-position;
    in property <bool> test-vector-size-available;
    in property <string> test-vector-size-range;
    callback select-vector-size(float);
    in-out property <float> test-core-value;
    in-out property <float> cpu-core-value;
    in property <float> cpu-core-maximum;
    in-out property <int> test-cpu-index;
    in-out property <int> test-gpu-index;
    in-out property <int> test-ram-index;
    in-out property <int> test-vram-index;
    in-out property <int> test-offload-index;
    in-out property <int> test-traffic-mode-index;
    in-out property <float> test-traffic-rate;
    in property <string> test-traffic-preview;
    in-out property <int> test-dataset-index;
    in property <bool> test-is-offload;
    in property <bool> test-has-ram;
    in property <bool> test-dataset-custom;
    in-out property <string> selected-template-id;
    in property <[TemplateRow]> setup-templates;
    in property <[string]> builder-workloads;
    in property <int> builder-workload-index;
    in property <bool> builder-gpu-compute;
    in property <[string]> builder-precisions;
    in property <int> builder-precision-index;
    in property <[string]> builder-placements;
    in property <int> builder-placement-index;
    in property <[string]> builder-dataset-presets;
    in property <int> builder-dataset-index;
    in property <bool> batch-builder;
    callback builder-choice(string, int);
    callback template-action(string, string);
    callback batch-builder-changed(bool);
    in-out property <int> custom-panel;
    in property <int> custom-advanced-count;
    function show-custom-panel(panel: int) {
        root.custom-panel = panel;
        root.configuration-scroll-offset = 0px;
    }
    in property <bool> test-configuration-valid;
    in property <string> test-configuration-summary;
    in property <string> test-cpu-name;
    in property <string> test-gpu-name;
    in property <string> test-core-name;
    in property <string> test-ram-name;
    in property <string> test-vram-name;
    in property <string> test-offload-name;
    in property <string> test-dataset-mode;
    in-out property <string> test-dataset-text;
    callback toggle-test-override(bool);
    callback select-test-configuration(string, int);
    callback edit-test-dataset(string);
    in-out property <string> vram-budget-name;
    callback select-vram-budget(int);
    in-out property <string> ram-budget-name;
    callback select-ram-budget(int);
    callback select-cpu-cores(int);
    in-out property <string> cpu-intensity-name;
    in-out property <string> gpu-intensity-name;
    in property <string> settings-status;
    in property <string> test-preferences-status;
    in-out property <string> load-description;
    callback select-cpu-intensity(int);
    callback select-gpu-intensity(int);
    in-out property <string> status: "Starting benchmark worker...";
    in-out property <bool> worker-online: false;
    in-out property <string> suite-description: "";
    in-out property <[string]> gpu-adapters: [];
    in-out property <int> selected-gpu: -1;
    in-out property <string> selected-gpu-name: "No compatible GPU selected";
    in-out property <bool> show-gpu-selector: false;
    in-out property <string> target-hardware-name: "Discovering hardware...";
    in-out property <string> target-hardware-description: "";
    in-out property <string> selected-benchmark-name: "No benchmark selected";
    in-out property <string> selected-benchmark-description: "Select a benchmark to view its details and run it.";
    in-out property <string> selected-benchmark-details;
    private property <bool> tuning-notes-expanded: false;
    in-out property <string> selected-benchmark-availability: "";
    in-out property <bool> selected-benchmark-enabled: false;
    in-out property <[DeviceRow]> devices: [];
    in-out property <[BenchmarkRow]> benchmarks: [];
    in-out property <[SummaryRow]> result-summaries: [];
    in property <bool> history-open;
    in property <bool> history-selected;
    in property <string> history-active-id;
    in property <string> history-active-title;
    in property <bool> history-pinned;
    in property <bool> history-archived;
    in property <bool> history-busy;
    in property <bool> history-can-export;
    in property <bool> history-delete-pending;
    in property <[HistoryRow]> history-rows;
    in property <string> history-counts;
    in property <int> history-page-index;
    in property <int> history-page-count;
    in property <int> history-filter-index;
    in property <string> history-query;
    in property <string> history-status;
    in property <string> history-import-error;
    private property <bool> history-import-details;
    changed history-import-error => { root.history-import-details = false; }
    in property <[DeviceFact]> history-facts;
    in property <[DeviceFact]> history-provenance;
    private property <string> history-detail-view;
    changed history-active-id => { root.history-detail-view = ""; }
    changed history-open => { root.history-detail-view = ""; }
    in property <ObservationView> result-observations;
    in property <ObservationView> history-observations;
    in property <bool> history-has-result;
    in property <bool> history-has-partial-observations;
    callback result-observation-change(string, int);
    callback history-observation-change(string, int);
    callback history-filter(int);
    in-out property <int> result-view: 0;
    in property <[DeviceFact]> result-technical;
    in property <string> selected-native-id;
    in property <string> selected-metric-label;
    in property <[DeviceFact]> selected-metric-facts;
    callback open-result-observations();
    in property <[DeviceFact]> comparison-facts;
    in property <[TuningBar]> core-comparison;
    in-out property <bool> comparison-expanded: false;
    in property <string> history-name;
    in property <string> history-notes;
    callback history-action(string);
    callback select-history(string);
    callback check-history(string, bool);
    callback search-history(string);
    callback save-history-annotation(string, string);
    in property <[SnapshotChoice]> queue-rows;
    callback queue-action(int);
    in property <bool> large-template-available;
    callback prepare-task(string);
    in property <[string]> primary-choices;
    in-out property <int> primary-selection: 0;
    callback select-primary(int);
    in property <string> measurement-context;
    in-out property <bool> historical-visible: false;
    in property <bool> snapshot-include-all;
    in property <bool> snapshot-open;
    in property <bool> snapshot-ready;
    in property <string> snapshot-status;
    in property <image> snapshot-preview;
    in property <[SnapshotChoice]> snapshot-choices;
    callback snapshot-action(string);
    callback toggle-snapshot-result(int, bool);

    in-out property <[string]> result-components: [];
    in-out property <int> result-component-index;
    in property <bool> history-result-view;
    in-out property <ResultRow> selected-result;
    in-out property <int> result-count;
    in-out property <int> result-header-count;
    in-out property <bool> result-has-bandwidth;
    in-out property <int> bandwidth-mode: 0;
    in-out property <[string]> comparison-options: [];
    in-out property <int> comparison-index;
    in-out property <string> comparison-note;
    in-out property <string> results-file-status;
    callback select-comparison(int);
    in-out property <int> result-selection;
    callback select-result-component(int);
    callback select-result-row(int);
    in-out property <string> expanded-device-id: "";
    in-out property <bool> result-details-expanded: false;
    // Return to Overview if the selected result lacks the previous tab's data.
    private property <int> active-result-view: (root.result-view == 1 && root.selected-result.profile-sizes.length == 0 && root.memory-dataset-rows.length == 0) || (root.result-view == 2 && !root.selected-result.gpu-timing-visible) || (root.result-view == 4 && root.demand-facts.length == 0) || (root.result-view == 5 && root.selected-native-id == "") ? 0 : root.result-view;
    in-out property <bool> shorter-run: false;
    in-out property <int> profile-selection: -1;
    private property <int> profile-index: root.profile-selection >= 0 && root.profile-selection < root.selected-result.profile-sizes.length ? root.profile-selection : max(0, root.selected-result.profile-sizes.length - 1);
    private property <bool> profile-sampling-expanded: false;
    private property <bool> result-about-expanded: false;
    in-out property <int> device-count: 0;
    in-out property <int> available-device-count: 0;
    in-out property <int> benchmark-count: 0;
    in-out property <bool> running: false;
    in-out property <int> queued-count: 0;
    in-out property <float> progress: 0;
    in-out property <string> progress-message: "";

    callback select-page(int); callback select-suite(string); callback select-gpu(int);
    callback select-benchmark(string); callback toggle-device-details(string); callback toggle-result-details();
    in property <bool> test-is-codec;
    in property <bool> test-is-sieve;
    in-out property <int> codec-corpus-index;
    in-out property <int> codec-size-index;
    in-out property <int> codec-block-index;
    in-out property <int> codec-level-index;
    in-out property <int> sieve-size-index;
    in-out property <int> matrix-shape-index;
    in-out property <int> matrix-reuse-index;
    in-out property <int> matrix-block-index;
    in-out property <int> sustained-index;
    in property <bool> core-experiment-applicable;
    in property <[DatasetRow]> memory-dataset-rows;
    in property <image> memory-dataset-chart;
    in property <[ChartPoint]> memory-dataset-chart-points;
    in property <bool> memory-dataset-chart-visible;
    in property <bool> result-is-demand;
    in property <[DeviceFact]> demand-facts;
    callback detail-search(string,string);
    in property <bool> core-experiment-enabled;
    in property <string> core-experiment-preview;
    callback run-core-experiment();
    in-out property <int> access-pattern-index;
    in-out property <int> access-fresh-index;
    in-out property <int> access-ensemble-index;
    in-out property <int> access-block-index;
    in-out property <int> ascii-content-index;
    in-out property <string> access-seed-text;
    in-out property <string> access-dataset-text;
    in property <bool> has-access-control;
    in property <bool> has-block-control;
    in property <bool> has-seed-control;
    in property <bool> is-latency-control;
    callback edit-access-text(string,string);
    in-out property <[string]> family-modes;
    in-out property <int> family-mode-index: -1;
    in-out property <string> family-title;
    in-out property <string> capability-details;
    in-out property <string> family-plan-summary;
    in-out property <string> category-plan-summary;
    in-out property <string> custom-plan-summary;
    in-out property <string> custom-plan-details;
    in-out property <int> custom-plan-count;
    in-out property <[string]> supported-preset-names;
    in-out property <string> family-plan-details;
    in-out property <string> category-plan-details;
    in-out property <string> configured-plan-summary;
    in property <int> plan-scope;
    in property <bool> plan-valid;
    in property <string> plan-error;
    in property <[DeviceFact]> plan-facts;
    in property <bool> plan-filter-visible;
    in property <[ConditionRow]> plan-rows;
    in property <string> plan-page;
    in property <[ConditionRow]> condition-queue;
    in property <string> queue-summary;
    in property <int> queue-filter-index;
    in-out property <bool> hardware-technical-expanded: false;
    callback plan-scope-changed(int);
    callback plan-search(string);
    callback plan-action(string,int);
    callback queue-filter-changed(int);
    in-out property <bool> test-has-core-control;
    callback select-supported-preset(int);
    callback select-family-mode(int);
    callback run-family();
    callback add-custom-condition();
    callback run-custom-plan();
    callback clear-custom-plan();
    callback run-selected(); callback run-all(); callback cancel(); callback clear-results(); callback rescan-hardware();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 240px; horizontal-stretch: 0; background: Theme.sidebar; border-color: Theme.border; border-width: 1px;
            VerticalLayout {
                padding: 20px; spacing: 4px;
                HorizontalLayout { height: 40px; spacing: 8px;
                    Image { width: 38px; height: 38px; source: @image-url("icons/logo.svg"); image-fit: contain; }
                    VerticalLayout { spacing: 1px; Text { text: "Gluj-Bench"; color: Theme.text; font-size: 18px; font-weight: 600; } Text { text: "Hardware benchmarking"; color: Theme.muted; font-size: 11px; } }
                }
                Rectangle { height: 20px; }
                ChoiceButton { text: "System Information"; left-aligned: true; selected: root.page == 0; clicked => { root.select-page(0); } }
                ChoiceButton { text: "Benchmarks"; left-aligned: true; selected: root.page == 1; clicked => { root.select-page(1); } }
                ChoiceButton { text: "Benchmark Results"; left-aligned: true; selected: root.page == 2; clicked => { root.select-page(2); } }
                ChoiceButton { text: "Settings"; left-aligned: true; selected: root.page == 3; clicked => { root.select-page(3); } }
                Rectangle { vertical-stretch: 1; }
                Surface {
                    height: root.worker-online ? 36px : 108px; vertical-stretch: 0;
                    VerticalLayout { padding: 8px; spacing: 8px; alignment: center;
                        HorizontalLayout { spacing: 8px; height: 16px; vertical-stretch: 0;
                            Rectangle {
                                width: 8px;
                                Rectangle { width: 6px; height: 6px; y: (parent.height - self.height) / 2; border-radius: 3px; background: root.worker-online ? Theme.success : Theme.danger; }
                            }
                            Label { text: root.worker-online ? "Engine ready" : "Engine offline"; vertical-alignment: center; }
                        }
                        if !root.worker-online: Text { text: "Benchmarks are unavailable"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                        if !root.worker-online: ActionButton { text: "Reconnect engine"; clicked => { root.rescan-hardware(); } }
                    }
                }
                Text { text: "Version " + root.app-version; color: Theme.muted; font-size: 11px; }
            }
        }
        Rectangle {
            horizontal-stretch: 1; min-width: 0px; background: Theme.canvas;
            VerticalLayout {
                padding: 28px; spacing: 16px;
                if root.page == 0: overview-scroll := ScrollView {
                    vertical-stretch: 1; viewport-width: self.width;
                    viewport-height: max(self.visible-height, overview-content.preferred-height);
                    overview-content := VerticalLayout {
                        x: 0px; y: 0px;
                        width: overview-scroll.visible-width - 16px; height: self.preferred-height;
                        spacing: 16px; padding-bottom: 24px; alignment: start;
                        HorizontalLayout { height: 64px; vertical-stretch: 0; spacing: 16px;
                            VerticalLayout { spacing: 8px; horizontal-stretch: 1;
                                Label { text: "Hardware and capabilities"; }
                                SectionTitle { text: "System Information"; }
                            }
                            ActionButton { width: 142px; height: 36px; vertical-stretch: 0; text: "Refresh hardware"; enabled: !root.running; clicked => { root.rescan-hardware(); } }
                        }
                        HorizontalLayout { height: max(24px, readiness-text.preferred-height); vertical-stretch: 0; spacing: 8px;
                            if root.system-ready: Image { width: 20px; height: 20px; source: @image-url("icons/check.svg"); image-fit: contain; }
                            readiness-text := Text {
                                horizontal-stretch: 1; text: root.system-ready ? "Hardware scan complete" : root.status;
                                color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-alignment: center;
                            }
                        }
                        HorizontalLayout { height: 76px; vertical-stretch: 0; spacing: 12px;
                            Rectangle { horizontal-stretch: 1; VerticalLayout { padding: 12px; spacing: 4px; Label { text: "Components"; } MeasureText { text: root.device-count; color: Theme.text; font-size: 24px; font-weight: 600; } } }
                            Rectangle { horizontal-stretch: 1; VerticalLayout { padding: 12px; spacing: 4px; Label { text: "Ready to benchmark"; } MeasureText { text: root.available-device-count; color: Theme.text; font-size: 24px; font-weight: 600; } } }
                            Rectangle { horizontal-stretch: 1; VerticalLayout { padding: 12px; spacing: 4px; Label { text: "Benchmark families"; } MeasureText { text: root.benchmark-count; color: Theme.text; font-size: 24px; font-weight: 600; } } }
                        }
                        HorizontalLayout { height: 20px; vertical-stretch: 0;
                            Label { text: "Inside your system"; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        for device in root.devices: Rectangle {
                            height: hardware-content.preferred-height;
                            vertical-stretch: 0; background: transparent;
                            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.border; }
                            hardware-content := VerticalLayout { padding: 12px; spacing: 12px; alignment: start;
                                HorizontalLayout { spacing: 12px; vertical-stretch: 0;
                                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: Theme.inset;
                                        Image { width: 32px; height: 32px; x: 8px; y: 8px; source: device.category == "CPU" ? @image-url("icons/cpu.svg") : device.category == "MEMORY" ? @image-url("icons/memory.svg") : @image-url("icons/gpu.svg"); image-fit: contain; colorize: Theme.muted; }
                                    }
                                    VerticalLayout { horizontal-stretch: 1; spacing: 4px;
                                        Label { text: device.category == "CPU" ? "Processor" : device.category == "MEMORY" ? "System memory" : "Graphics device"; }
                                        Text { text: device.name; color: Theme.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                                    }
                                    ActionButton { width: 88px; height: 32px; vertical-stretch: 0; text: root.expanded-device-id == device.id ? "Less detail" : "Details"; clicked => { root.toggle-device-details(device.id); } }
                                }
                                HorizontalLayout { spacing: 12px; vertical-stretch: 0;
                                    for fact in device.facts: Rectangle {
                                        horizontal-stretch: 1; height: max(64px, fact-content.preferred-height); background: transparent;
                                        fact-content := VerticalLayout { padding: 12px; spacing: 4px;
                                            Text { text: fact.label; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                            MeasureText { text: fact.value; color: Theme.body; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                                        }
                                    }
                                }
                                if !device.available || device.badges.length > 0: HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                    if !device.available: Rectangle { width: 94px; height: 30px; border-radius: 4px; background: #3a3020;
                                        Text { text: "Unavailable"; color: Theme.warning; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    for badge in device.badges: Rectangle { horizontal-stretch: 1; height: max(30px, badge-text.preferred-height + 12px); background: Theme.panel; border-radius: 4px;
                                        badge-text := Text { x: 8px; y: 6px; width: parent.width - 16px; height: self.preferred-height; text: badge; color: Theme.iris; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                }
                                if root.expanded-device-id == device.id: VerticalLayout { spacing: 12px; vertical-stretch: 0;
                                    Rectangle { height: 1px; background: Theme.border; }
                                    Label { text: "Hardware details"; color: device.accent; }
                                    FactRows { rows: device.topology; }
                                    FactRows { rows: device.support; }
                                    ActionButton { text: root.hardware-technical-expanded ? "Hide technical properties" : "Technical properties"; clicked => { root.hardware-technical-expanded = !root.hardware-technical-expanded; } }
                                    if root.hardware-technical-expanded: VerticalLayout { spacing: 8px; Input { placeholder-text: "Filter properties"; edited => { root.detail-search("hardware",self.text); } } FactRows { rows: device.technical; } if device.technical.length == 0: Text { text: "No matching properties"; color: Theme.muted; font-size: 12px; } }

                                }
                            }
                        }
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 12px; vertical-stretch: 1; min-height: 0px;
                    HorizontalLayout { spacing: 16px; vertical-stretch: 0;
                        SectionTitle { text: "Benchmarks"; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.show-gpu-selector && root.gpu-adapters.length > 0: Picker { width: 320px; enabled: !root.running; model: root.gpu-adapters; current-value: root.selected-gpu-name; selected(value) => { root.show-custom-panel(0); root.selected-template-id = ""; root.select-gpu(self.current-index); } }
                        if !root.show-gpu-selector: Text { text: root.target-hardware-name; color: Theme.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: right; }
                    }
                    HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                        ChoiceButton { text: "CPU memory"; selected: root.suite-description == "Cache/RAM bandwidth and dependent RAM read latency with sample statistics."; clicked => { root.show-custom-panel(0); root.selected-template-id = ""; root.select-suite("cpu.bandwidth"); } }
                        ChoiceButton { text: "CPU performance"; selected: root.suite-description == "Aggregate processor throughput, single-thread INT64, and compute-vs-memory diagnosis."; clicked => { root.show-custom-panel(0); root.selected-template-id = ""; root.select-suite("cpu.performance"); } }
                        ChoiceButton { text: "GPU bandwidth"; selected: root.suite-description == "Estimated cache, GPU-local memory, and host-device bandwidth."; clicked => { root.show-custom-panel(0); root.selected-template-id = ""; root.select-suite("gpu.bandwidth"); } }
                        ChoiceButton { text: "GPU performance"; selected: root.suite-description == "Register throughput, working-set scaling, and capability-gated matrix performance."; clicked => { root.show-custom-panel(0); root.selected-template-id = ""; root.select-suite("gpu.performance"); } }
                    }
                    benchmark-layout := HorizontalLayout {
                    spacing: 16px; vertical-stretch: 1; min-height: 0px;
                    Rectangle { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; VerticalLayout { spacing: 0px;
                        HorizontalLayout { height: 32px; vertical-stretch: 0; spacing: 8px; padding-left: 12px; padding-right: 28px;
                            Label { text: "Experiments"; horizontal-stretch: 1; vertical-alignment: center; }
                            Label { text: "Minimum"; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                            Rectangle { width: 80px; }
                        }
                        Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }
                        templates-scroll := ScrollView { vertical-stretch: 1; viewport-width: self.width;
                            VerticalLayout { width: templates-scroll.visible-width - 16px; spacing: 0px; alignment: start;
                                if root.setup-templates.length == 0: Text { text: "No experiments available for this hardware"; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                for template[index] in root.setup-templates: VerticalLayout { spacing: 0px; vertical-stretch: 0;
                                    if index == 0 || template.group != root.setup-templates[index - 1].group: Rectangle {
                                        height: 32px; vertical-stretch: 0;
                                        Label { x: 12px; width: parent.width - 24px; height: parent.height; text: template.group; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 80px; vertical-stretch: 0;
                                        background: root.selected-template-id == template.id ? Theme.selection : Theme.canvas;
                                        Rectangle { width: 2px; height: parent.height; background: root.selected-template-id == template.id ? Theme.brass : transparent; }
                                        HorizontalLayout { padding: 12px; spacing: 8px;
                                            VerticalLayout { spacing: 4px; alignment: center; horizontal-stretch: 1; min-width: 0px; preferred-width: 0px;
                                                Text { text: template.title; color: Theme.text; font-size: 14px; font-weight: 500; overflow: elide; }
                                                Text { text: template.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                                                MeasureText { text: template.coverage; font-size: 11px; overflow: elide; }
                                            }
                                            MeasureText { text: template.duration; width: 64px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                            VerticalLayout { width: 80px; spacing: 4px; alignment: center;
                                                ActionButton { text: "Run"; height: 28px; enabled: !root.running && root.worker-online; clicked => { root.selected-template-id = template.id; root.template-action("run", template.id); } }
                                                ActionButton { text: "Customize"; height: 24px; enabled: !root.running; clicked => { root.selected-template-id = template.id; root.show-custom-panel(0); root.template-action("customize", template.id); } }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.border; vertical-stretch: 0; }
                                }
                            }
                        }
                    } }
                    Rectangle { width: 320px; horizontal-stretch: 0;
                        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.border; }
                        VerticalLayout { padding-left: 16px; padding-right: 0px; padding-top: 0px; padding-bottom: 0px; spacing: 12px;
                        HorizontalLayout { height: 32px; vertical-stretch: 0; spacing: 8px;
                            Text { text: root.custom-panel == 0 ? "Custom test" : root.custom-panel == 1 ? "Advanced settings" : root.custom-panel == 2 ? "Unsupported operations" : "Core comparison"; color: Theme.text; font-size: 16px; font-weight: 500; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            if root.custom-panel != 0: ActionButton { text: "Back"; width: 64px; clicked => { root.show-custom-panel(0); } }
                            if root.custom-panel == 0: Rectangle { width: 64px; }
                        }
                        configuration-scroll := ScrollView { viewport-width: self.width; vertical-stretch: 1;
                            viewport-y <=> root.configuration-scroll-offset;
                            viewport-height: max(self.visible-height, configuration-content.preferred-height);
                            configuration-content := VerticalLayout { x: 0px; y: 0px; width: configuration-scroll.visible-width - 16px; height: self.preferred-height; spacing: 12px; alignment: start;
                            if root.custom-panel == 0: VerticalLayout { spacing: 8px; vertical-stretch: 0;
                                Label { text: "Workload"; }
                                Picker { model: root.builder-workloads; current-index: root.builder-workload-index; enabled: !root.running && root.builder-workloads.length > 0; selected(value) => { root.show-custom-panel(0); root.selected-template-id = ""; root.builder-choice("workload",self.current-index); } }
                                if root.builder-gpu-compute: VerticalLayout { spacing: 8px; vertical-stretch: 0;
                                    Label { text: "Precision"; }
                                    Picker { model: root.builder-precisions; current-index: root.builder-precision-index; enabled: !root.running && root.builder-precisions.length > 0; selected(value) => { root.selected-template-id = ""; root.builder-choice("precision",self.current-index); } }
                                    Label { text: "Data placement"; }
                                    Picker { model: root.builder-placements; current-index: root.builder-placement-index; enabled: !root.running && root.builder-placements.length > 0; selected(value) => { root.selected-template-id = ""; root.builder-choice("placement",self.current-index); } }
                                }
                                if !root.builder-gpu-compute && root.family-modes.length > 1: VerticalLayout { spacing: 8px; vertical-stretch: 0;
                                    Label { text: "Variant"; }
                                    Picker { model: root.family-modes; current-index <=> root.family-mode-index; enabled: !root.running; selected(value) => { root.configuration-scroll-offset = 0px; root.selected-template-id = ""; root.select-family-mode(self.current-index); } }
                                }
                                if !root.selected-benchmark-enabled: Text { text: root.selected-benchmark-availability; color: Theme.warning; font-size: 12px; wrap: word-wrap; }
                                if root.capability-details != "": ActionButton {
                                    text: "Unsupported operations"; width: 176px;
                                    clicked => { root.show-custom-panel(2); }
                                }
                            }
                            if root.custom-panel == 0: HorizontalLayout {
                                spacing: 8px; vertical-stretch: 0;
                                ActionButton {
                                    width: 128px;
                                    text: root.custom-advanced-count > 0 ? "Advanced (" + root.custom-advanced-count + ")" : "Advanced";
                                    clicked => { root.show-custom-panel(1); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton { text: "Reset"; width: 64px; enabled: !root.running && root.test-vector-can-reset; clicked => { root.selected-template-id = ""; root.reset-vector-configuration(); } }
                            }
                            if root.custom-panel <= 1 && !root.test-configuration-valid: Text { text: root.test-configuration-summary; color: Theme.warning; font-size: 12px; wrap: word-wrap; }
                            if root.custom-panel == 0 && root.batch-builder && root.custom-plan-count > 0: Text { text: "Editing next test | " + root.custom-plan-count + " in list"; color: Theme.muted; font-size: 12px; }
                            if root.custom-panel == 0: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                if root.test-is-configurable-compute && !(root.test-is-matrix && root.matrix-shape-index != 0): VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    if !root.builder-gpu-compute: Label { text: "Data preset"; }
                                    if !root.builder-gpu-compute: Picker { model: root.supported-preset-names; current-index <=> root.test-vector-preset-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-supported-preset(self.current-index); } }
                                    if root.builder-gpu-compute && !root.test-vector-register: Label { text: "Dataset sizing"; }
                                    if root.builder-gpu-compute && !root.test-vector-register: Picker { model: root.builder-dataset-presets; current-index: root.builder-dataset-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.builder-choice("dataset",self.current-index); } }
                                    if !root.test-vector-register && !root.test-vector-legacy: Picker { height: 36px; vertical-stretch: 0; model: root.test-is-offload ? ["Static size (one dataset)", "Dynamic size (sweep to target)"] : ["One dataset", "Sweep to target"]; current-index <=> root.test-vector-mode-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("vector-mode", self.current-index); } }
                                    if root.test-vector-custom: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                        Label { text: "Dataset size · " + root.test-vector-size; }
                                        Slider { height: 32px; vertical-stretch: 0; minimum: 0; maximum: 1000; step: 1; value <=> root.test-vector-size-position; enabled: !root.running && root.test-vector-size-available; changed(value) => { root.selected-template-id = ""; root.select-vector-size(value); } }
                                    }
                                    if !root.test-vector-custom || root.test-is-offload: Text { text: root.test-vector-preview; color: Theme.iris; font-size: 12px; wrap: word-wrap; }
                                }
                                if root.test-is-scaling && (!root.test-is-configurable-compute || root.test-vector-legacy): VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Dataset mode"; }
                                    Picker { height: 36px; vertical-stretch: 0; model: ["Automatic (allocation budget)", "Sweep up to chosen size", "Test one chosen size"]; current-index <=> root.test-dataset-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("dataset", self.current-index); } }
                                    Label { text: "Dataset size (MiB)"; }
                                    Input { height: 36px; vertical-stretch: 0; text <=> root.test-dataset-text; enabled: !root.running && root.test-dataset-custom; edited => { root.edit-test-dataset(self.text); } }
                                    Text { text: "1024 MiB = 1 GiB · Sizes follow alignment"; color: Theme.quiet; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.test-has-core-control: VerticalLayout { spacing: 8px;
                                    Label { text: "Physical CPU cores"; }
                                    Text { text: root.test-core-name; color: Theme.iris; font-size: 12px; }
                                    Slider { height: 32px; vertical-stretch: 0; minimum: 1; maximum: max(2, root.cpu-core-maximum); step: 1; value <=> root.test-core-value; enabled: !root.running && root.cpu-core-maximum > 1; changed(value) => { root.selected-template-id = ""; root.select-test-configuration("cores", round(value)); } }
                                }
                                if root.test-is-codec: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "DEFLATE corpus"; }
                                    Picker { model: ["Compressible", "Mixed", "Incompressible"]; current-index <=> root.codec-corpus-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("codec-corpus",self.current-index); } }
                                    Picker { model: ["1 MiB corpus", "16 MiB corpus", "64 MiB corpus", "256 MiB corpus"]; current-index <=> root.codec-size-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("codec-size",self.current-index); } }
                                    Picker { model: ["Level 0 (stored)", "Level 1", "Level 6", "Level 9"]; current-index <=> root.codec-level-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("codec-level",self.current-index); } }
                                }
                                if root.test-is-sieve: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Sieve range"; }
                                    Picker { model: ["2 through 10,000", "2 through 100,000", "2 through 1,000,000", "2 through 10,000,000", "2 through 100,000,000"]; current-index <=> root.sieve-size-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("sieve-size",self.current-index); } }
                                    Text { text: "Complete sieve per worker"; color: Theme.quiet; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.test-is-matrix: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Matrix shape (M × N × K)"; }
                                    Picker { model: ["Legacy: 32 rows / worker, K=N", "Square: 128 × 128 × 128", "Tall: 512 × 128 × 128", "Wide: 128 × 512 × 128"]; current-index <=> root.matrix-shape-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("matrix-shape",self.current-index); } }
                                }
                                if root.has-access-control: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Access pattern"; }
                                    Picker { model: (root.test-is-gpu-vector || root.test-is-gpu-memory) ? ["Sequential (coalesced lanes)", "Shuffled blocks (coalesced lanes)", "Rotating start regions", "Scattered lanes (changes coalescing)"] : root.test-is-codec ? ["Sequential independent blocks", "Shuffled independent blocks"] : ["Sequential", "Shuffled blocks", "Rotating start regions", "Scattered kernel blocks", "Hot/cold reuse"]; current-index <=> root.access-pattern-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("access",self.current-index); } }
                                }
                                if root.is-latency-control: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Working set (empty for automatic)"; }
                                    Input { text <=> root.access-dataset-text; enabled: !root.running; edited => { root.edit-access-text("dataset",self.text); } }
                                    Text { text: "One dependent chain"; color: Theme.quiet; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.test-is-ascii: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                    Label { text: "Input content"; }
                                    Picker { model: ["Patterned ASCII", "Seeded mixed ASCII", "No hits", "All hits"]; current-index <=> root.ascii-content-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("ascii-content",self.current-index); } }
                                }
                                if root.test-is-gpu-memory: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Memory operation"; }
                                    Picker { model: ["Read / write / copy separately", "Read", "Write", "Copy"]; current-index <=> root.memory-operation-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("memory-operation",self.current-index);} }
                                }
                                if root.test-is-transfer: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                    Label { text: "Transfer direction"; }
                                    Picker { model: ["Both directions (separate measurements)", "Host to device", "Device to host"]; current-index <=> root.transfer-direction-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("transfer-direction",self.current-index);} }
                                }
                                if root.test-is-gpu-matrix: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                    Label { text: "Matrix tile"; }
                                    Picker { model: root.gpu-matrix-tile-names; current-index <=> root.gpu-matrix-tile-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("gpu-matrix-tile",self.current-index);} }
                                    Text { text: root.test-is-gpu-int8-matrix ? "INT32 accumulation" : "FP32 accumulation"; color: Theme.muted; font-size: 11px; }
                                }
                                if root.test-is-offload: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Input and output in system RAM"; }
                                    Picker { height: 36px; vertical-stretch: 0; model: ["50% system RAM", "75% system RAM", "100% system RAM"]; current-index <=> root.test-offload-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("offload", self.current-index); } }
                                }
                            }
                            if root.custom-panel == 1: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                if root.test-is-codec: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                    Label { text: "Compression block"; }
                                    Picker { model: ["4 KiB independent blocks", "64 KiB independent blocks", "1 MiB independent blocks"]; current-index <=> root.codec-block-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("codec-block",self.current-index); } }
                                }
                                if root.test-is-matrix && root.matrix-shape-index != 0: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                    Label { text: "Matrix reuse"; }
                                    if root.matrix-shape-index != 0: Picker { model: ["One complete product / pass", "Four products / pass", "Sixteen products / pass"]; current-index <=> root.matrix-reuse-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("matrix-reuse",self.current-index); } }
                                    Label { text: "K block"; }
                                    if root.matrix-shape-index != 0: Picker { model: ["K block: 32", "K block: 128", "K block: 256"]; current-index <=> root.matrix-block-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("matrix-block",self.current-index); } }
                                }
                                if root.test-is-cpu || root.test-is-gpu-vector || root.test-is-gpu-memory || root.test-is-transfer || root.test-is-gpu-matrix: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Measurement duration"; }
                                    Picker { model: root.test-is-gpu-vector ? ["Standard coverage", "At least 15 measurement seconds / test", "At least 60 measurement seconds / test"] : ["Standard coverage", "At least 15 active seconds / test", "At least 60 active seconds / test"]; current-index <=> root.sustained-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("sustained",self.current-index); } }
                                    Text { text: "Duration applies to each realization."; color: Theme.quiet; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.has-seed-control: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Workload seed"; }
                                    Picker { model: ["Fixed root seed", "Fresh root seed for each run"]; current-index <=> root.access-fresh-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("access-fresh",self.current-index); } }
                                    if root.access-fresh-index == 0: Input { text <=> root.access-seed-text; enabled: !root.running; edited => { root.edit-access-text("seed",self.text); } }
                                    Picker { model: ["One realization", "Three realizations (equal coverage each)"]; current-index <=> root.access-ensemble-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("access-ensemble",self.current-index); } }
                                    if root.has-block-control: Label { text: root.is-latency-control ? "Locality block (localized chains)" : "Access block target"; }
                                    if root.has-block-control: Picker { model: ["64 B (kernel alignment may raise this)", "4 KiB", "64 KiB", "1 MiB"]; current-index <=> root.access-block-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("access-block",self.current-index); } }
                                }
                                if root.test-is-gpu-memory && (root.memory-operation-index == 0 || root.memory-operation-index == 3): VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                    Label { text: "Copy implementation"; }
                                    Picker { model: ["Workload default (shader for irregular access)", "Shader copy", "Native Vulkan copy (sequential)"]; current-index <=> root.memory-copy-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("memory-copy",self.current-index);} }
                                    Text { text: "Native copy requires sequential access. Size is per buffer."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.test-is-transfer: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Transfer submission"; }
                                    Picker { model: ["One staging buffer", "Three staging buffers", "Eight staging buffers"]; current-index <=> root.staging-buffers-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("staging-buffers",self.current-index);} }
                                    Picker { model: ["Batched submissions", "Serial: wait after each copy"]; current-index <=> root.transfer-submission-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("transfer-submission",self.current-index);} }
                                    if root.transfer-submission-index == 0: Picker { model: ["One copy / submission", "Eight copies / submission", "32 copies / submission"]; current-index <=> root.transfer-batch-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("transfer-batch",self.current-index);} }
                                    Text { text: "Directions measured separately · Mean copy cost, not latency percentiles"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.test-is-gpu-matrix && !root.test-vector-register: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Matrix reuse and traversal"; }
                                    Picker { model: ["Reuse: 1", "Reuse: 4", "Reuse: 8", "Reuse: 16", "Reuse: 64"]; current-index <=> root.gpu-matrix-reuse-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("gpu-matrix-reuse",self.current-index);} }
                                    Picker { model: ["Sequential tiles", "Shuffled whole tiles", "Rotating tile start"]; current-index <=> root.gpu-matrix-traversal-index; enabled: !root.running; selected(value)=>{root.selected-template-id = ""; root.select-test-configuration("gpu-matrix-traversal",self.current-index);} }
                                    Text { text: "Independent dense tiles · Not full matrix multiplication"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.test-is-offload: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "Traffic rate"; }
                                    Picker { height: 36px; vertical-stretch: 0; model: ["Maximum throughput", "Dynamic: growing traffic", "Static: fixed passes/s"]; current-index <=> root.test-traffic-mode-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("offload-traffic", self.current-index); } }
                                    if root.test-traffic-mode-index != 0: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                        Text { text: root.test-traffic-preview; color: Theme.iris; font-size: 12px; wrap: word-wrap; }
                                        Slider { height: 32px; vertical-stretch: 0; minimum: root.test-traffic-mode-index == 1 ? 0 : 1; maximum: 1000; step: 1; value <=> root.test-traffic-rate; enabled: !root.running; changed(value) => { root.selected-template-id = ""; root.select-test-configuration(root.test-traffic-mode-index == 1 ? "offload-bandwidth" : "offload-rate", round(value)); } }
                                    }
                                    Text { text: root.test-traffic-mode-index == 1 ? "Requested traffic at 1 MiB. 4× the dataset → 2× traffic and half the passes/s. Includes cache hits." : root.test-traffic-mode-index == 2 ? "Fixed request arrivals: larger datasets increase demand. Delay and pending work show overload. Requested traffic includes cache hits. Activity follows requests without pacing." : "Runs as fast as the hardware and activity settings allow."; color: Theme.quiet; font-size: 11px; wrap: word-wrap; }
                                }
                                if root.test-is-cpu: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "CPU activity"; }
                                    Picker { height: 36px; vertical-stretch: 0; model: ["95%", "99%", "100%"]; current-index <=> root.test-cpu-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("cpu", self.current-index); } }
                                }
                                if root.test-is-gpu: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "GPU activity"; }
                                    Picker { height: 36px; vertical-stretch: 0; model: ["95%", "99%", "100%"]; current-index <=> root.test-gpu-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("gpu", self.current-index); } }
                                }
                                if root.test-has-ram: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "RAM budget"; }
                                    Picker { height: 36px; vertical-stretch: 0; model: ["20% of RAM", "25% of RAM", "30% of RAM", "40% of RAM", "50% of RAM", "60% of RAM", "70% of RAM", "80% of RAM"]; current-index <=> root.test-ram-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("ram", self.current-index); } }
                                }
                                if root.test-is-gpu && root.test-is-scaling && !root.test-vector-register && (!root.test-is-offload || root.test-offload-index != 2): VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                    Label { text: "VRAM budget"; }
                                    Picker { height: 36px; vertical-stretch: 0; model: ["20% of VRAM", "25% of VRAM", "30% of VRAM", "40% of VRAM", "50% of VRAM", "60% of VRAM", "70% of VRAM", "80% of VRAM"]; current-index <=> root.test-vram-index; enabled: !root.running; selected(value) => { root.selected-template-id = ""; root.select-test-configuration("vram", self.current-index); } }
                                }
                            }
                            if root.custom-panel == 2: Text {
                                text: root.capability-details != "" ? root.capability-details : "All listed operations are supported.";
                                color: Theme.body; font-size: 12px; wrap: word-wrap;
                            }
                            if root.custom-panel == 3: VerticalLayout { spacing: 8px; vertical-stretch: 0; height: self.preferred-height; alignment: start;
                                Label { text: "Fixed-work core comparison"; }
                                Text { text: root.core-experiment-preview; color: Theme.body; font-size: 12px; wrap: word-wrap; }
                            }
                            if root.custom-panel == 0: CheckBox { text: "Build a batch"; checked: root.batch-builder; enabled: !root.running; toggled => { root.batch-builder-changed(self.checked); } }
                            if root.custom-panel == 0 && root.core-experiment-applicable: ActionButton { text: "Compare CPU core counts"; enabled: !root.running; clicked => { root.show-custom-panel(3); } }
                            if root.custom-panel == 0 && root.batch-builder: VerticalLayout { spacing: 8px; height: self.preferred-height; vertical-stretch: 0; alignment: start;
                                HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                    Label { text: "Planned tests"; horizontal-stretch: 1; vertical-alignment: center; }
                                    if root.plan-scope == 1: ActionButton { text: "Add current test"; enabled: !root.running && root.selected-benchmark-enabled && root.test-configuration-valid; clicked => { root.add-custom-condition(); } }
                                }
                                VerticalLayout { spacing: 8px; height: self.preferred-height; vertical-stretch: 0; alignment: start;
                                    if root.plan-filter-visible: Input { placeholder-text: "Filter tests, sizes or access"; enabled: !root.running; edited => { root.plan-search(self.text); } }
                                    if root.plan-filter-visible && root.plan-page != "": Text { text: root.plan-page; color: Theme.muted; font-size: 12px; }
                                    if root.plan-rows.length == 0: Text { text: "No matching tests"; color: Theme.muted; font-size: 12px; }
                                    for row[index] in root.plan-rows: VerticalLayout { spacing: 8px; height: self.preferred-height; vertical-stretch: 0; alignment: start;
                                        if index == 0 || row.group != root.plan-rows[index - 1].group: Label { text: row.group; color: Theme.brass; }
                                        HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                            CheckBox { text: "Run"; width: 56px; height: 24px; vertical-stretch: 0; checked: row.included; enabled: !root.running; toggled => { root.plan-action(self.checked ? "include" : "exclude", row.index); } }
                                            Text { text: row.title; color: row.included ? Theme.text : Theme.quiet; font-size: 12px; horizontal-stretch: 1; wrap: word-wrap; }
                                            ActionButton { text: row.expanded ? "Hide details" : "Details"; width: 100px; height: 26px; enabled: !root.running; clicked => { root.plan-action("details",row.index); } }
                                        }
                                        HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                            Text { text: row.dataset; color: Theme.iris; horizontal-stretch: 1; wrap: word-wrap; }
                                            Text { text: row.workers; color: Theme.iris; }
                                            if root.custom-plan-count > 0: ActionButton { text: "Remove"; width: 70px; height: 24px; enabled: !root.running; clicked => { root.plan-action("remove",row.index); } }
                                        }
                                        if row.mode != "": Text { text: row.mode; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                        if row.expanded: FactRows { rows: row.details; }
                                        Rectangle { height: 1px; background: Theme.border; }
                                    }
                                }
                                if root.batch-builder: HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                    HistoryMenu { label: "List actions"; horizontal-stretch: 1;
                                        items: [{label: "Compare tests", action: "compare", enabled: !root.running && root.custom-plan-count > 1}, {label: "Clear list", action: "clear", enabled: !root.running && root.custom-plan-count > 0}];
                                        choose(action) => { if action == "clear" { root.clear-custom-plan(); } else { root.prepare-task(action); } }
                                    }
                                }
                            }
                    } }

                        if !root.running && root.custom-panel != 3: VerticalLayout { spacing: 8px; vertical-stretch: 0;
                            Rectangle { height: 1px; background: Theme.border; }
                            PlanReadout { rows: root.plan-facts; }
                            if root.plan-error != "": Text { text: root.plan-error; color: Theme.warning; font-size: 12px; wrap: word-wrap; }
                        }
                        if root.custom-panel == 3: ActionButton { text: "Run core comparison"; primary: true; enabled: root.core-experiment-enabled && root.worker-online && !root.running; clicked => { root.run-core-experiment(); } }
                        if !root.running && root.status != "" && root.status != "Hardware capabilities scanned and saved for future launches." && root.status != "Benchmark completed.": Text { text: root.status; color: Theme.warning; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                        if root.running: VerticalLayout { spacing: 4px;
                            Label { text: "Queue"; }
                            Text { text: root.queue-summary; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                            Picker { model: ["All tests", "Active / pending", "Completed", "Interrupted / skipped"]; current-index: root.queue-filter-index; selected(value) => { root.queue-filter-changed(self.current-index); } }
                            if root.condition-queue.length == 0: Text { text: "No matching tests"; color: Theme.muted; font-size: 12px; }
                            if root.condition-queue.length > 0: queue-scroll := ScrollView { height: 170px; vertical-stretch: 0; viewport-height: max(self.visible-height, queue-content.preferred-height);
                                queue-content := VerticalLayout { x: 0px; y: 0px; width: queue-scroll.visible-width - 12px; height: self.preferred-height; spacing: 8px;
                                    for row in root.condition-queue: VerticalLayout { spacing: 4px; vertical-stretch: 0;
                                        HorizontalLayout { Text { text: row.title; color: Theme.body; wrap: word-wrap; horizontal-stretch: 1; } Text { text: row.status; color: row.status == "Completed" ? Theme.success : row.status == "Failed" ? Theme.danger : Theme.warning; } }
                                        Text { text: row.dataset + " · " + row.workers + " · " + row.mode; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                        if row.action != "": ActionButton { text: row.action; clicked => { root.queue-action(row.index); } }
                                    }
                                }
                            }
                        }
                        if root.running: VerticalLayout { spacing: 8px; Label { text: "Benchmark in progress"; color: Theme.brass; } Text { text: root.progress-message; color: Theme.text; font-size: 13px; wrap: word-wrap; } ProgressIndicator { progress: root.progress; } }
                        if !root.running && root.custom-panel != 3: VerticalLayout { spacing: 12px; CheckBox { text: "Shorter run"; checked <=> root.shorter-run; toggled => { root.select-default-configuration("measurement", self.checked ? 1 : 0); } } Text { text: root.shorter-run ? "3 observations / test · ≥ 0.3 s" : "6 observations / test · ≥ 1.5 s"; color: Theme.muted; font-size: 11px; wrap: word-wrap; } ActionButton { text: root.batch-builder ? "Run batch" : "Run custom test"; primary: true; enabled: root.worker-online && root.plan-valid; clicked => { root.plan-action("run",0); } } }
                    } }
                }
                }
                if root.page == 3: settings-scroll := ScrollView {
                    vertical-stretch: 1; min-height: 0px; preferred-height: 0px;
                    viewport-width: self.width;
                    viewport-height: max(self.visible-height, settings-content.preferred-height);
                    settings-content := VerticalLayout {
                        x: 0px; y: 0px; width: settings-scroll.visible-width - 16px;
                        height: self.preferred-height; padding-bottom: 12px; spacing: 12px; alignment: start;
                        VerticalLayout {
                            spacing: 4px;
                            SectionTitle { text: "Settings"; }
                            Text { text: "Defaults for tests that use global settings."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                        if root.settings-status != "": Text { text: root.settings-status; color: Theme.warning; font-size: 12px; wrap: word-wrap; }
                        if root.test-preferences-status != "": Text { text: root.test-preferences-status; color: Theme.warning; font-size: 12px; wrap: word-wrap; }
                        SettingsGroup {
                            title: "CPU";
                            SettingsRow {
                                title: "Activity target"; detail: "Share of time spent doing work.";
                                Picker { model: ["95%", "99%", "100%"]; current-value: root.cpu-intensity-name; enabled: !root.running; selected(value) => { root.select-cpu-intensity(self.current-index); } }
                            }
                            SettingsRow {
                                title: "Physical cores"; detail: "One worker per core. Latency tests use one.";
                                HorizontalLayout {
                                    spacing: 8px;
                                    Slider {
                                        height: 36px; horizontal-stretch: 1;
                                        minimum: 1; maximum: max(2, root.cpu-core-maximum); step: 1;
                                        value <=> root.cpu-core-value;
                                        enabled: !root.running && root.cpu-core-maximum > 1;
                                        changed(value) => { root.select-cpu-cores(round(value)); }
                                    }
                                    Text {
                                        width: 64px;
                                        text: (root.cpu-core-value == root.cpu-core-maximum ? "All " : "") + round(root.cpu-core-value);
                                        color: Theme.iris; font-size: 12px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        SettingsGroup {
                            title: "GPU";
                            SettingsRow {
                                title: "Activity target"; detail: "Controls benchmark pacing.";
                                Picker { model: ["95%", "99%", "100%"]; current-value: root.gpu-intensity-name; enabled: !root.running; selected(value) => { root.select-gpu-intensity(self.current-index); } }
                            }
                            SettingsRow {
                                title: "RAM offload"; detail: "Share of offload test inputs and outputs in system RAM.";
                                Picker { model: ["50% system RAM", "75% system RAM", "100% system RAM"]; current-value: root.default-offload-name; enabled: !root.running; selected(value) => { root.select-default-configuration("offload", self.current-index); } }
                            }
                        }
                        SettingsGroup {
                            title: "Scaling";
                            SettingsRow {
                                title: "Dataset mode";
                                detail: root.default-dataset-custom ? "" : "Sweeps up to the allocation budget.";
                                Picker { model: ["Automatic (allocation budget)", "Sweep up to chosen size", "Test one chosen size"]; current-value: root.default-dataset-mode; enabled: !root.running; selected(value) => { root.select-default-configuration("dataset", self.current-index); } }
                            }
                            if root.default-dataset-custom: SettingsRow {
                                title: "Dataset size (MiB)";
                                detail: "1024 MiB = 1 GiB";
                                Input { accessible-label: "Dataset size in MiB"; text: root.default-dataset-text; enabled: !root.running; edited => { root.edit-default-dataset(self.text); } }
                            }
                            if root.default-dataset-custom && root.default-dataset-error != "": Text { text: root.default-dataset-error; color: Theme.warning; font-size: 12px; wrap: word-wrap; horizontal-alignment: right; }
                            SettingsRow {
                                title: "System RAM budget"; detail: "Available memory may lower this limit.";
                                Picker { model: ["20% of RAM", "25% of RAM", "30% of RAM", "40% of RAM", "50% of RAM", "60% of RAM", "70% of RAM", "80% of RAM"]; current-value: root.ram-budget-name; enabled: !root.running; selected(value) => { root.select-ram-budget(self.current-index); } }
                            }
                            SettingsRow {
                                title: "VRAM budget"; detail: "Driver limits also apply.";
                                Picker { model: ["20% of VRAM", "25% of VRAM", "30% of VRAM", "40% of VRAM", "50% of VRAM", "60% of VRAM", "70% of VRAM", "80% of VRAM"]; current-value: root.vram-budget-name; enabled: !root.running; selected(value) => { root.select-vram-budget(self.current-index); } }
                            }
                        }
                    }
                }
                if root.page == 2: results-scroll := ScrollView {
                    vertical-stretch: 1; min-height: 0px; preferred-height: 0px;
                    viewport-width: self.width;
                    viewport-height: max(self.visible-height, results-content.preferred-height);
                    results-content := VerticalLayout {
                        x: 0px; y: 0px;
                    width: results-scroll.visible-width - 16px;
                    height: self.preferred-height;
                    padding-bottom: 24px; spacing: 12px; alignment: start;
                    HorizontalLayout { height: 58px; vertical-stretch: 0;
                        VerticalLayout { spacing: 4px;
                            SectionTitle { text: "Benchmark Results"; }
                            Text { text: root.result-count + (root.result-count == 1 ? " saved result" : " saved results"); color: Theme.muted; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { text: "Run history"; height: 34px; enabled: !root.running; clicked => { root.history-action("open"); } }
                        ActionButton { text: "Import snapshot"; height: 34px; enabled: !root.running; clicked => { root.snapshot-action("import"); } }
                        ActionButton { text: "Share results"; height: 34px; enabled: root.result-count > 0 && !root.running; clicked => { root.snapshot-action("open"); } }
                        ActionButton { width: 116px; height: 34px; vertical-stretch: 0; text: "Clear view"; enabled: root.result-count > 0; clicked => { root.clear-results(); } }
                    }
                    if root.history-open && !root.running: Surface {
                        height: history-content.preferred-height; vertical-stretch: 0;
                        history-content := VerticalLayout {
                            padding: 12px; spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Run history"; color: Theme.text; font-size: 18px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                                ActionButton { width: 72px; height: 36px; text: "Close"; clicked => { root.history-action("close"); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Input {
                                    placeholder-text: "Search tests, names or notes";
                                    text: root.history-query;
                                    horizontal-stretch: 1;
                                    edited => { history-table.viewport-y = 0px; root.search-history(self.text); }
                                }
                                Picker {
                                    width: 148px;
                                    model: ["All runs", "Completed", "Cancelled / failed", "Imported", "Archived"];
                                    current-index: root.history-filter-index;
                                    selected(value) => { history-table.viewport-y = 0px; root.history-filter(self.current-index); }
                                }
                                HistoryMenu {
                                    width: 72px; label: "Files...";
                                    items: [
                                        { label: "Import native JSON", action: "import-native", enabled: !root.history-busy },
                                        { label: "Export native JSON", action: "export", enabled: root.history-can-export && !root.history-busy },
                                        { label: "Refresh runs", action: "refresh", enabled: !root.history-busy },
                                    ];
                                    choose(action) => { root.history-action(action); }
                                }
                            }
                            if root.history-import-error != "": HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Could not import this run file."; color: Theme.warning; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                ActionButton { width: 88px; text: root.history-import-details ? "Hide details" : "Details"; clicked => { root.history-import-details = !root.history-import-details; } }
                            }
                            if root.history-import-error != "" && root.history-import-details: Text { text: root.history-import-error; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            history-table := ScrollView {
                                height: clamp(root.history-rows.length * 52px - 4px, 48px, 256px);
                                viewport-height: max(self.visible-height, history-list.preferred-height);
                                history-list := VerticalLayout {
                                    x: 0px; y: 0px;
                                    width: history-table.visible-width - (root.history-rows.length > 5 ? 14px : 0px);
                                    height: self.preferred-height; spacing: 4px; alignment: start;
                                    if root.history-rows.length == 0: Text {
                                        height: 48px; text: "No matching runs"; color: Theme.muted; font-size: 12px; vertical-alignment: center;
                                    }
                                    for run in root.history-rows: Rectangle {
                                        height: 48px; border-radius: 5px;
                                        background: root.history-active-id == run.id ? Theme.selection : history-row-touch.has-hover ? Theme.hover : Theme.inset;
                                        border-color: Theme.iris; border-width: history-row-focus.has-focus ? 1px : 0px;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 10px; spacing: 8px;
                                            Rectangle {
                                                width: 24px;
                                                CheckBox {
                                                    width: 24px; height: 32px; y: (parent.height - self.height) / 2;
                                                    accessible-label: "Select for export: " + run.name;
                                                    checked: run.checked;
                                                    toggled => { root.check-history(run.id, self.checked); }
                                                }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                forward-focus: history-row-focus;
                                                accessible-role: button;
                                                accessible-label: run.name + ", " + run.date + ", " + run.source + ", " + run.status;
                                                accessible-action-default => { history-row-touch.clicked(); }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                        Text { text: run.name; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                                                        Text { text: run.date + "  |  " + run.source; color: Theme.muted; font-size: 11px; overflow: elide; }
                                                    }
                                                    Text { width: 86px; text: run.status; color: run.status == "Completed" ? Theme.success : run.status == "Failed" ? Theme.danger : Theme.warning; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                                    Text { width: 60px; text: run.observations + " obs."; color: Theme.muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                                }
                                                history-row-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.select-history(run.id); }
                                                }
                                                history-row-focus := FocusScope {
                                                    width: 0px;
                                                    key-pressed(event) => {
                                                        if event.text == " " || event.text == "\n" {
                                                            history-row-touch.clicked();
                                                            return accept;
                                                        }
                                                        return reject;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px; height: root.history-page-count > 1 ? 36px : 22px;
                                Text { text: root.history-counts; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                                if root.history-page-count > 1: ActionButton {
                                    width: 72px; height: 36px; text: "Previous";
                                    enabled: root.history-page-index > 0 && !root.history-busy;
                                    clicked => { history-table.viewport-y = 0px; root.history-action("previous"); }
                                }
                                if root.history-page-count > 1: Text {
                                    text: (root.history-page-index + 1) + " / " + root.history-page-count;
                                    color: Theme.muted; font-size: 11px; vertical-alignment: center;
                                }
                                if root.history-page-count > 1: ActionButton {
                                    width: 72px; height: 36px; text: "Next";
                                    enabled: root.history-page-index + 1 < root.history-page-count && !root.history-busy;
                                    clicked => { history-table.viewport-y = 0px; root.history-action("next"); }
                                }
                            }
                            if root.history-selected: Rectangle { height: 1px; background: Theme.border; }
                            if root.history-selected: HorizontalLayout {
                                spacing: 8px;
                                Text { text: root.history-active-title; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                if root.history-has-result: ActionButton {
                                    width: 112px; height: 36px; text: "Open result";
                                    clicked => { root.history-action("view"); }
                                }
                                if root.history-has-partial-observations: ActionButton {
                                    width: 136px; height: 36px;
                                    text: root.history-detail-view == "samples" ? "Hide samples" : "Partial samples";
                                    clicked => { root.history-detail-view = root.history-detail-view == "samples" ? "" : "samples"; }
                                }
                                HistoryMenu {
                                    width: 72px; label: "Actions...";
                                    items: [
                                        { label: root.history-has-result ? "Compare with this run" : "", action: "baseline", enabled: !root.history-busy },
                                        { label: root.history-has-result ? (root.history-pinned ? "Unpin baseline" : "Pin as baseline") : "", action: "pin", enabled: !root.history-busy },
                                        { label: "Edit name and notes", action: "edit", enabled: !root.history-busy },
                                        { label: root.history-detail-view == "technical" ? "Hide technical details" : "Technical details", action: "technical", enabled: true },
                                        { label: root.history-archived ? "Restore run" : "Archive run", action: "archive", enabled: !root.history-busy },
                                        { label: "Delete run...", action: "delete", enabled: !root.history-busy },
                                    ];
                                    choose(action) => {
                                        if action == "edit" || action == "technical" {
                                            root.history-detail-view = root.history-detail-view == action ? "" : action;
                                        } else {
                                            root.history-detail-view = "";
                                            root.history-action(action);
                                        }
                                    }
                                }
                            }
                            if root.history-selected && root.history-detail-view == "technical": VerticalLayout {
                                spacing: 8px;
                                FactRows { rows: root.history-facts; }
                                FactRows { rows: root.history-provenance; }
                            }
                            if root.history-has-partial-observations && root.history-detail-view == "samples": ObservationPanel {
                                view: root.history-observations;
                                change(action, index) => { root.history-observation-change(action, index); }
                            }
                            if root.history-selected && root.history-detail-view == "edit": VerticalLayout {
                                spacing: 8px;
                                run-name := Input { placeholder-text: "Run name"; text: root.history-name; }
                                run-notes := Input { placeholder-text: "Notes"; text: root.history-notes; }
                                HorizontalLayout {
                                    alignment: end; spacing: 8px;
                                    ActionButton { width: 72px; text: "Cancel"; clicked => { root.history-detail-view = ""; } }
                                    ActionButton {
                                        width: 72px; text: "Save";
                                        clicked => { root.save-history-annotation(run-name.text, run-notes.text); root.history-detail-view = ""; }
                                    }
                                }
                            }
                            if root.history-delete-pending: HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Permanently delete this run?"; color: Theme.warning; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                ActionButton { width: 72px; text: "Cancel"; clicked => { root.history-action("keep"); } }
                                ActionButton { width: 112px; text: "Delete run"; clicked => { root.history-action("confirm-delete"); } }
                            }
                            if root.history-status != "": Text { text: root.history-status; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    if root.snapshot-status != "": Text { text: root.snapshot-status; color: Theme.iris; font-size: 12px; wrap: word-wrap; }
                    if root.snapshot-open: Surface {
                        height: snapshot-content.preferred-height; vertical-stretch: 0;
                        snapshot-content := VerticalLayout { padding: 16px; spacing: 12px;
                            HorizontalLayout { Text { text: "Create a result snapshot"; color: Theme.text; font-size: 20px; font-weight: 600; horizontal-stretch: 1; } ActionButton { text: "Close"; clicked => { root.snapshot-action("close"); } } }
                            Text { text: "Checked results appear in the image and its embedded comparison data."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            CheckBox { text: "Embed comparison data for all completed results"; checked: root.snapshot-include-all; toggled => { root.snapshot-action("include-all"); } }
                            HorizontalLayout { spacing: 8px;
                                ActionButton { text: "Select highlights"; enabled: !root.running; clicked => { root.snapshot-action("highlights"); } }
                                ActionButton { text: "Copy image"; primary: true; enabled: root.snapshot-ready && !root.running; clicked => { root.snapshot-action("copy"); } }
                                ActionButton { text: "Save PNG"; enabled: root.snapshot-ready && !root.running; clicked => { root.snapshot-action("save"); } }
                            }
                            HorizontalLayout { spacing: 12px;
                                snapshot-choices-scroll := ScrollView { width: parent.width * 0.48; height: 390px;
                                    viewport-height: max(self.visible-height, snapshot-choices-content.preferred-height);
                                    snapshot-choices-content := VerticalLayout { x: 0px; y: 0px; spacing: 12px; alignment: start;
                                        width: snapshot-choices-scroll.visible-width - 12px; height: self.preferred-height;
                                        for choice[index] in root.snapshot-choices: Rectangle {
                                            height: choice-content.preferred-height; vertical-stretch: 0;
                                            choice-content := VerticalLayout { spacing: 4px; height: self.preferred-height;
                                                HorizontalLayout { spacing: 8px; height: max(24px, choice-title.preferred-height); vertical-stretch: 0;
                                                    CheckBox { width: 22px; checked: choice.selected; enabled: !root.running; toggled => { root.toggle-snapshot-result(index, self.checked); } }
                                                    choice-title := Text { text: choice.title; color: Theme.text; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                                }
                                                Text { text: choice.detail; color: Theme.quiet; font-size: 11px; wrap: word-wrap; height: self.preferred-height; vertical-stretch: 0; }
                                            }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; height: 390px; background: Theme.inset; border-radius: 8px;
                                    Image { source: root.snapshot-preview; image-fit: contain; width: parent.width; height: parent.height; vertical-alignment: top; }
                                }
                            }
                            Text { text: "Keep the original PNG; image editors may remove comparison data."; color: Theme.quiet; font-size: 11px; wrap: word-wrap; }
                        }
                    }
                    if root.result-count == 0: Surface { height: 190px; vertical-stretch: 0;
                        VerticalLayout { padding: 24px; spacing: 12px;
                            Text { text: "No measurements yet"; color: Theme.text; font-size: 22px; font-weight: 600; }
                            Text { text: "Run a test to add measurements."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            ActionButton { width: 150px; height: 36px; text: "Open Benchmarks"; primary: true; clicked => { root.select-page(1); } }
                        }
                    }
                    if root.result-count > 0: HorizontalLayout { height: 40px; vertical-stretch: 0; spacing: 12px;
                        Label { text: "Component"; width: 84px; vertical-alignment: center; }
                        Picker { horizontal-stretch: 1; model: root.result-components; current-index <=> root.result-component-index; selected(value) => { root.select-result-component(self.current-index); } }
                        if root.result-has-bandwidth: ActionButton { height: 36px; text: root.bandwidth-mode == 2 ? "Memory: Change" : root.bandwidth-mode == 1 ? "Memory: Typical" : "Memory: Latest"; clicked => { root.bandwidth-mode = mod(root.bandwidth-mode + 1, 3); } }
                    }
                    if root.result-count > 0: HorizontalLayout { height: 40px; vertical-stretch: 0; spacing: 12px;
                        Label { text: "Compare with"; width: 84px; vertical-alignment: center; }
                        Picker { horizontal-stretch: 1; model: root.comparison-options; current-index <=> root.comparison-index; selected(value) => { root.select-comparison(self.current-index); } }
                    }
                    if root.result-count > 0: CheckBox { text: "Show best matching run"; checked <=> root.historical-visible; }
                    if root.result-count > 0: summary-table := Rectangle {
                        Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.border; }
                        height: min(360px, max(100px, root.result-summaries.length * 68px + root.result-header-count * 32px + 16px));
                        vertical-stretch: 0;
                        summary-scroll := ScrollView {
                        viewport-height: max(self.visible-height, summary-rows.preferred-height);
                        summary-rows := VerticalLayout { width: summary-scroll.visible-width; height: self.preferred-height; padding: 8px; spacing: 4px; alignment: start;
                            for row[index] in root.result-summaries: VerticalLayout {
                                spacing: 4px; vertical-stretch: 0;
                                if index == 0 || root.result-summaries[index - 1].section != row.section: HorizontalLayout {
                                    height: 28px; vertical-stretch: 0; spacing: 12px; padding-left: 8px; padding-right: 8px;
                                    Label { text: row.bandwidth ? (root.bandwidth-mode == 2 ? "Memory / change" : root.bandwidth-mode == 1 ? "Memory / typical" : "Memory / latest") : (row.section == 3 ? "Latency (lower is better)" : row.section == 1 ? "Cache and transfers" : "Compute"); horizontal-stretch: 1; }
                                    if row.bandwidth: Label { text: "Read"; width: 80px; horizontal-alignment: right; }
                                    if row.bandwidth: Label { text: "Write"; width: 80px; horizontal-alignment: right; }
                                    if row.bandwidth: Label { text: "Copy"; width: 80px; horizontal-alignment: right; }
                                    if !row.bandwidth: Label { text: "Latest"; width: 100px; horizontal-alignment: right; }
                                    if !row.bandwidth: Label { text: root.historical-visible ? "Best" : "Typical"; width: 100px; horizontal-alignment: right; }
                                    if !row.bandwidth: Label { text: "Change"; width: 64px; horizontal-alignment: right; }
                                    Label { text: "Runs"; width: 38px; horizontal-alignment: right; }
                                }
                                Rectangle {
                                    height: 64px; vertical-stretch: 0; border-radius: 4px;
                                    background: root.result-selection == index ? Theme.selection : row-touch.has-hover ? Theme.hover : Theme.inset;
                                    border-width: row-focus.has-focus ? 1px : 0px;
                                    border-color: Theme.iris;
                                    forward-focus: row-focus;
                                    accessible-role: button;
                                    accessible-label: row.title + (row.configuration != "" ? ", " + row.configuration : "") + (row.recorded-at != "" ? ", " + row.recorded-at : "");
                                    accessible-action-default => { row-touch.clicked(); }
                                    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 12px;
                                        VerticalLayout { spacing: 2px; alignment: center; horizontal-stretch: 1;
                                            Text { text: row.title; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                                            if row.configuration != "": Text { text: row.configuration; color: Theme.muted; font-size: 11px; overflow: elide; }
                                            HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                                Text { text: row.recorded-at; color: Theme.muted; font-size: 11px; overflow: elide; min-width: 0px; horizontal-stretch: 0; }
                                                NewBadge { fresh: row.is-new; }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                        if row.bandwidth: MeasureText { text: root.bandwidth-mode == 2 ? row.read-delta : root.bandwidth-mode == 1 ? (root.historical-visible ? row.read-best : row.read-typical) : row.read-latest; color: Theme.body; font-size: 11px; width: 80px; horizontal-alignment: right; vertical-alignment: center; }
                                        if row.bandwidth: MeasureText { text: root.bandwidth-mode == 2 ? row.write-delta : root.bandwidth-mode == 1 ? (root.historical-visible ? row.write-best : row.write-typical) : row.write-latest; color: Theme.body; font-size: 11px; width: 80px; horizontal-alignment: right; vertical-alignment: center; }
                                        if row.bandwidth: MeasureText { text: root.bandwidth-mode == 2 ? row.copy-delta : root.bandwidth-mode == 1 ? (root.historical-visible ? row.copy-best : row.copy-typical) : row.copy-latest; color: Theme.body; font-size: 11px; width: 80px; horizontal-alignment: right; vertical-alignment: center; }
                                        if !row.bandwidth: MeasureText { text: row.latest; color: Theme.body; font-size: 12px; width: 100px; horizontal-alignment: right; vertical-alignment: center; }
                                        if !row.bandwidth: MeasureText { text: root.historical-visible ? row.best : row.typical; color: Theme.body; font-size: 12px; width: 100px; horizontal-alignment: right; vertical-alignment: center; }
                                        if !row.bandwidth: MeasureText { text: row.delta; color: Theme.muted; font-size: 11px; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                                        MeasureText { text: row.runs; color: Theme.quiet; font-size: 11px; width: 38px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    row-touch := TouchArea {
                                        width: parent.width; height: parent.height; mouse-cursor: pointer;
                                        clicked => {
                                            root.tuning-notes-expanded = false;
                                            root.profile-selection = -1;
                                            root.profile-sampling-expanded = false;
                                            root.result-about-expanded = false;
                                            root.select-result-row(index);
                                        }
                                    }
                                    row-focus := FocusScope {
                                        width: 0px;
                                        key-pressed(event) => {
                                            if event.text == " " || event.text == "\n" {
                                                row-touch.clicked();
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                    if root.result-count > 0: result-detail := Rectangle {
                        Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.border; }
                        private property <length> observations-height-floor;
                        private property <length> observations-scroll-anchor;
                        private property <bool> observations-loaded: root.active-result-view == 5 && !root.result-observations.loading;
                        height: max(max(220px, context-content.preferred-height + 56px), root.active-result-view == 5 ? self.observations-height-floor : 0px);
                        changed observations-loaded => {
                            if self.observations-loaded {
                                // The sample list is populated after the loading layout. Restore the original anchor.
                                results-scroll.viewport-y = self.observations-scroll-anchor;
                            }
                        }
                        vertical-stretch: 0;
                        VerticalLayout { padding: 12px; spacing: 8px; alignment: start;
                            HorizontalLayout { height: 24px; vertical-stretch: 0; spacing: 8px;
                                Label { text: root.history-result-view ? "Saved measurement" : "Latest measurement"; color: Theme.brass; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.selected-result.recorded-at; horizontal-stretch: 0; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                NewBadge { fresh: root.selected-result.is-new; }
                                Text { text: root.selected-result.sample-count + " • " + root.selected-result.elapsed; width: 150px; horizontal-alignment: right; overflow: elide; color: Theme.quiet; font-size: 11px; vertical-alignment: center; }
                            }
                                context-content := VerticalLayout { height: self.preferred-height; vertical-stretch: 0; padding-bottom: 8px; spacing: 8px; alignment: start;
                                    Text { text: root.selected-result.title; color: Theme.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                                    if root.comparison-facts.length > 0: ActionButton { text: root.comparison-expanded ? "Hide comparison differences" : "Comparison differences"; clicked => { root.comparison-expanded = !root.comparison-expanded; } }
                                    if root.comparison-expanded && root.comparison-facts.length > 0: FactRows { rows: root.comparison-facts; }
                                    if root.comparison-note != "": Text { text: root.comparison-note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    Label { text: root.selected-metric-label; }
                                    MeasureText { text: root.selected-result.primary-value; color: Theme.text; font-size: 28px; font-weight: 600; }
                                    FactRows { rows: root.selected-metric-facts; }
                                    if root.primary-choices.length > 0: Picker { model: root.primary-choices; current-index <=> root.primary-selection; selected(value) => { root.select-primary(self.current-index); } }
                                    if root.result-is-demand && root.selected-result.profile-sizes.length > 0: FactRows { rows: root.selected-result.profile-measurements[root.profile-index].facts; }
                                    if root.measurement-context != "": Text { text: root.measurement-context; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    if root.selected-result.throughput-points.length > 1 || root.selected-result.dataset-loss != "": VerticalLayout {
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Label { text: "Throughput by dataset"; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                                            if root.selected-result.dataset-loss != "": Text {
                                                text: root.selected-result.dataset-loss;
                                                color: Theme.body; font-size: 12px; font-weight: 600; horizontal-alignment: right;
                                            }
                                        }
                                        if root.selected-result.throughput-points.length > 1: InteractiveChart {
                                            chart: root.selected-result.throughput-chart;
                                            labels: root.selected-result.throughput-labels;
                                            points: root.selected-result.throughput-points;
                                            source-height: 200;
                                            plot: { left: 110, right: 870, top: 26, bottom: 146 };
                                        }
                                    }
                                    ActionButton { text: root.result-details-expanded ? "Hide details" : "Details & measurements"; clicked => { root.toggle-result-details(); } }
                                    if root.result-details-expanded: HorizontalLayout { spacing: 4px;
                                        ChoiceButton { text: "Overview"; selected: root.active-result-view == 0; clicked => { root.result-view = 0; } }
                                        if root.selected-result.profile-sizes.length > 0 || root.memory-dataset-rows.length > 0: ChoiceButton { text: "Datasets"; selected: root.active-result-view == 1; clicked => { root.result-view = 1; } }
                                        if root.selected-result.gpu-timing-visible: ChoiceButton { text: "Timing"; selected: root.active-result-view == 2; clicked => { root.result-view = 2; } }
                                        if root.demand-facts.length > 0: ChoiceButton { text: "Demand"; selected: root.active-result-view == 4; clicked => { root.result-view = 4; } }
                                        if root.selected-native-id != "": ChoiceButton {
                                            text: "Observations"; selected: root.active-result-view == 5; enabled: !root.running;
                                            clicked => {
                                                if root.result-view != 5 {
                                                    result-detail.observations-scroll-anchor = results-scroll.viewport-y;
                                                    let slack = max(0px, results-scroll.viewport-height - results-scroll.visible-height + results-scroll.viewport-y);
                                                    result-detail.observations-height-floor = results-scroll.viewport-y < 0px ? max(0px, result-detail.height - slack) : 0px;
                                                    root.open-result-observations();
                                                    root.result-view = 5;
                                                }
                                            }
                                        }
                                        ChoiceButton { text: "Technical"; selected: root.active-result-view == 3; clicked => { root.result-view = 3; } }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 5: ObservationPanel {
                                        view: root.result-observations;
                                        change(action, index) => { root.result-observation-change(action, index); }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 3: VerticalLayout { spacing: 8px; Input { placeholder-text: "Filter metadata"; edited => { root.detail-search("result",self.text); } } FactRows { rows: root.result-technical; } if root.result-technical.length == 0: Text { text: "No matching metadata"; color: Theme.muted; font-size: 12px; } }
                                    if root.result-details-expanded && root.active-result-view == 4 && root.result-is-demand: VerticalLayout { spacing: 8px; Label { text: "Median counts per observation"; } FactRows { rows: root.demand-facts; } Text { text: "Latency percentiles cover completed requests only."; color: Theme.muted; font-size: 11px; } }
                                    if root.result-details-expanded && root.active-result-view == 0 && !root.selected-result.compute-balance.visible && root.selected-result.measurement-facts.length <= 2 && root.selected-result.measurement-bars.length == 0 && root.selected-result.context-facts.length == 0 && root.core-comparison.length == 0: Text { text: "No additional measurements recorded"; color: Theme.muted; font-size: 12px; }
                                    if root.result-details-expanded && root.active-result-view == 0 && root.core-comparison.length > 0: VerticalLayout { spacing: 8px; Label { text: "Fixed-input comparison by core count"; }
                                        for bar in root.core-comparison: VerticalLayout { spacing: 4px; HorizontalLayout { Text { text: bar.label; color: Theme.muted; horizontal-stretch: 1; } Text { text: bar.value; color: Theme.brass; } } Rectangle { height: 10px; background: Theme.track; Rectangle { width: parent.width * bar.ratio; height: parent.height; background: Theme.brass; } } }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 0 && root.selected-result.compute-balance.visible && (root.result-is-demand || (root.selected-result.throughput-points.length == 0 && root.selected-result.dataset-loss == "")): VerticalLayout {
                                        spacing: 8px; vertical-stretch: 0; height: self.preferred-height;
                                        Label { text: "Compute throughput"; color: Theme.brass; }
                                        Text { text: root.selected-result.compute-balance.reference; color: Theme.iris; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                                        Rectangle { height: 22px; vertical-stretch: 0; background: Theme.track; border-radius: 5px; clip: true;
                                            Rectangle { x: 0px; y: 0px; width: parent.width * root.selected-result.compute-balance.retained-ratio; height: parent.height; background: Theme.brass; }
                                            if root.selected-result.compute-balance.has-loss: Rectangle {
                                                x: parent.width * root.selected-result.compute-balance.retained-ratio;
                                                width: parent.width * root.selected-result.compute-balance.loss-ratio; height: parent.height;
                                                background: #64748b;
                                            }
                                            Rectangle { x: min(parent.width - 2px, parent.width * root.selected-result.compute-balance.reference-ratio); width: 2px; height: parent.height; background: Theme.iris; }
                                            Rectangle { x: min(parent.width - 2px, parent.width * root.selected-result.compute-balance.retained-ratio); width: 2px; height: parent.height; background: Theme.text; }
                                        }
                                        Text { text: root.selected-result.compute-balance.settled; color: Theme.brass; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                                        if root.selected-result.compute-balance.delay != "": Text { text: root.selected-result.compute-balance.delay; color: root.selected-result.compute-balance.delay-warning ? Theme.danger : Theme.brass; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                                        if root.selected-result.compute-balance.has-loss: Text { text: root.selected-result.compute-balance.loss; color: Theme.muted; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                                        Text { text: root.selected-result.compute-balance.note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 0 && !root.selected-result.compute-balance.visible: VerticalLayout { height: self.preferred-height; vertical-stretch: 0; spacing: 8px;
                                        for fact[index] in root.selected-result.measurement-facts: VerticalLayout { height: self.preferred-height; vertical-stretch: 0; if index >= 2: HorizontalLayout { spacing: 12px; vertical-stretch: 0;
                                            Text { text: fact.label; color: Theme.muted; horizontal-stretch: 1; wrap: word-wrap; }
                                            Text { text: fact.value; color: Theme.body; horizontal-stretch: 1; horizontal-alignment: right; wrap: word-wrap; }
                                        } }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 0 && !root.selected-result.compute-balance.visible && root.selected-result.measurement-bars.length > 0: Label { text: "Measured sample spread"; color: Theme.brass; }
                                    if root.result-details-expanded && root.active-result-view == 0 && !root.selected-result.compute-balance.visible: VerticalLayout { spacing: 8px; height: self.preferred-height; vertical-stretch: 0;
                                        for bar in root.selected-result.measurement-bars: VerticalLayout { spacing: 4px; height: self.preferred-height; vertical-stretch: 0;
                                            HorizontalLayout { Text { text: bar.label; color: Theme.muted; font-size: 12px; } Text { text: bar.value; color: Theme.iris; font-size: 13px; horizontal-alignment: right; } }
                                            Rectangle { height: 12px; background: Theme.track; border-radius: 4px; vertical-stretch: 0;
                                                Rectangle { x: 0px; y: 0px; width: parent.width * bar.ratio; height: parent.height; background: bar.accent; border-radius: 4px; }
                                            }
                                        }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.memory-dataset-rows.length > 0: VerticalLayout { spacing: 8px;
                                        if root.running: Text { text: "Chart paused while testing"; color: Theme.muted; }
                                        if !root.running && root.memory-dataset-chart-visible: InteractiveChart {
                                            chart: root.memory-dataset-chart; points: root.memory-dataset-chart-points; source-height: 290;
                                            plot: { left: 100, right: 820, top: 40, bottom: 210 };
                                        }
                                        Label { text: "Dataset and operation · Value · Observed range · Count"; }
                                        memory-table := ScrollView { height: 260px; viewport-height: max(self.visible-height,memory-rows.preferred-height);
                                            memory-rows := VerticalLayout { x: 0px; y: 0px; width: memory-table.visible-width - 12px; height: self.preferred-height; spacing: 7px;
                                                for row in root.memory-dataset-rows: HorizontalLayout { spacing: 12px; vertical-stretch: 0;
                                                    Text { text: row.size + " · " + row.operation; color: Theme.muted; horizontal-stretch: 2; wrap: word-wrap; }
                                                    Text { text: row.median; color: Theme.brass; horizontal-stretch: 1; wrap: word-wrap; }
                                                    Text { text: row.range; color: Theme.muted; horizontal-stretch: 2; wrap: word-wrap; }
                                                    Text { text: row.count; color: Theme.muted; }
                                                }
                                            }
                                        }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 0 && !root.selected-result.compute-balance.visible && root.selected-result.measurement-bars.length > 0: Text { text: "Minimum · Median · Maximum"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    if root.result-details-expanded && root.active-result-view == 0 && !root.selected-result.compute-balance.visible && root.selected-result.context-facts.length > 0: context-row := HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                        for fact in root.selected-result.context-facts: Rectangle { width: (context-row.width - context-row.spacing * (root.selected-result.context-facts.length - 1)) / root.selected-result.context-facts.length; height: max(80px, context-card.preferred-height + 20px); vertical-stretch: 0; background: Theme.panel; border-radius: 8px;
                                            context-card := VerticalLayout { padding: 10px; spacing: 8px; alignment: start;
                                                Text { text: fact.label; color: Theme.iris; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                                                Text { text: fact.value; color: Theme.body; font-size: 13px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
                                            }
                                        }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.selected-result.profile-sizes.length > 1: Label { text: "Performance by dataset"; color: Theme.brass; }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.selected-result.profile-sizes.length > 1: InteractiveChart {
                                        chart: root.selected-result.profile-chart; labels: root.selected-result.profile-labels; points: root.selected-result.profile-points; source-height: 420;
                                        plot: { left: 110, right: 870, top: 42, bottom: 162 };
                                        second-plot: { left: 110, right: 870, top: 232, bottom: 352 };
                                    }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.selected-result.profile-sizes.length > 1: Text { text: "Median · Shaded observed range"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.selected-result.profile-sizes.length > 0: Picker { model: root.selected-result.profile-sizes; current-index: root.profile-index; selected(value) => { root.profile-selection = self.current-index; root.profile-sampling-expanded = false; } }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.selected-result.profile-sizes.length > 0: Rectangle {
                                        height: dataset-summary.preferred-height; vertical-stretch: 0; background: Theme.panel; border-radius: 8px;
                                        dataset-summary := VerticalLayout { padding: 12px; spacing: 8px; alignment: start;
                                            for fact in root.selected-result.profile-measurements[root.profile-index].facts: HorizontalLayout { spacing: 16px; vertical-stretch: 0;
                                                Text { text: fact.label; min-width: 0px; horizontal-stretch: 1; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                                Text { text: fact.value; min-width: 0px; horizontal-stretch: 2; color: Theme.body; font-size: 13px; font-weight: 600; horizontal-alignment: right; wrap: word-wrap; }
                                            }
                                        }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.selected-result.profile-sizes.length > 0 && root.selected-result.profile-measurements[root.profile-index].samples.length > 0: ActionButton { text: root.profile-sampling-expanded ? "▾ Sampling details" : "▸ Sampling details"; clicked => { root.profile-sampling-expanded = !root.profile-sampling-expanded; } }
                                    if root.result-details-expanded && root.active-result-view == 1 && root.profile-sampling-expanded && root.selected-result.profile-sizes.length > 0 && root.selected-result.profile-measurements[root.profile-index].samples.length > 0: VerticalLayout { padding: 12px; spacing: 8px; vertical-stretch: 0;
                                        for fact in root.selected-result.profile-measurements[root.profile-index].samples: HorizontalLayout { spacing: 16px; vertical-stretch: 0;
                                            Text { text: fact.label; min-width: 0px; horizontal-stretch: 1; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                            Text { text: fact.value; min-width: 0px; horizontal-stretch: 2; color: Theme.muted; font-size: 11px; horizontal-alignment: right; wrap: word-wrap; }
                                        }
                                    }
                                    if root.result-details-expanded && root.active-result-view == 2 && root.selected-result.gpu-timing-visible: Label { text: root.selected-result.gpu-timing-title; color: Theme.iris; }
                                    if root.result-details-expanded && root.active-result-view == 2 && root.selected-result.gpu-timing-available: InteractiveChart {
                                        chart: root.selected-result.gpu-timing-chart; labels: root.selected-result.gpu-timing-labels; points: root.selected-result.gpu-timing-points; source-height: root.selected-result.gpu-timing-height;
                                        plot: { left: 110, right: 870, top: 60, bottom: 220 };
                                    }
                                    if root.result-details-expanded && root.active-result-view == 2 && root.selected-result.gpu-timing-visible: Text { text: root.selected-result.gpu-timing-available ? "GPU / host timings · Inclusive intervals may overlap" : root.selected-result.gpu-timing-note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }

                                }
                        }
                    }
                    if root.results-file-status != "": Text { text: root.results-file-status; color: Theme.warning; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                    }
                }
            }
        }
    }
    // Keep the stop action accessible on every page, outside scrolling content.
    if root.running: Surface {
        x: 22px;
        y: root.height - self.height - 136px;
        width: 198px; height: 140px;
        background: #291c29; border-color: #d67888;
        VerticalLayout { padding: 16px; spacing: 8px;
            HorizontalLayout {
                Label { text: "Test running"; color: Theme.danger; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.queued-count + " queued"; color: #b7a1b3; font-size: 11px; }
            }
            Text { text: root.progress-message; color: #e4d4e3; font-size: 11px; overflow: elide; }
            ProgressIndicator { progress: root.progress; height: 6px; vertical-stretch: 0; }
            ActionButton {
                text: root.status == "Cancelling benchmark…" ? "Stopping…" : "Stop all tests";
                enabled: root.status != "Cancelling benchmark…";
                height: 38px; vertical-stretch: 0;
                clicked => { root.cancel(); }
            }
        }
    }
}
