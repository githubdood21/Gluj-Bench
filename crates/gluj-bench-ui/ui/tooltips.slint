import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One overlay keeps help inside the window and leaves input routing untouched.
export global Help {
    in-out property <bool> visible;
    in-out property <bool> suppressed;
    in-out property <string> copy;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-height;
    in-out property <length> window-width: 1280px;
    in-out property <length> window-height: 820px;
    in-out property <bool> beside;
    public function show(message: string, x: length, y: length, height: length, beside: bool) {
        if message != "" && !self.suppressed {
            self.copy = message; self.anchor-x = x; self.anchor-y = y;
            self.anchor-height = height; self.beside = beside; self.visible = true;
        }
    }
    public function hide(message: string, x: length, y: length) {
        if self.copy == message && self.anchor-x == x && self.anchor-y == y { self.visible = false; }
    }
    public function dismiss() { self.visible = false; self.suppressed = true; }
}

// Read hover state from the control's parent TouchArea; never place a hit target over a control.
export component HelpTracker inherits Rectangle {
    in property <string> copy;
    in property <bool> hovered;
    in property <bool> focused;
    in property <bool> beside;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-height;
    width: 0px; height: 0px;
    changed hovered => {
        hover-delay.stop();
        if self.hovered && self.copy != "" { Help.suppressed = false; hover-delay.start(); }
        else { Help.hide(root.copy, root.anchor-x, root.anchor-y); }
    }
    changed focused => {
        if self.focused && !self.hovered { Help.suppressed = false; Help.show(root.copy, root.anchor-x, root.anchor-y, root.anchor-height, root.beside); }
        else if !self.focused { Help.hide(root.copy, root.anchor-x, root.anchor-y); }
    }
    changed copy => { Help.dismiss(); }
    changed anchor-x => { hover-delay.stop(); Help.dismiss(); }
    changed anchor-y => { hover-delay.stop(); Help.dismiss(); }
    hover-delay := Timer { interval: 400ms; running: false;
        triggered => { self.stop(); if root.hovered { Help.show(root.copy, root.anchor-x, root.anchor-y, root.anchor-height, root.beside); } }
    }
}

export component InkRipple inherits Rectangle {
    in property <color> ripple-color: Theme.text;
    in property <length> corner-radius: 4px;
    private property <length> origin-x: self.width / 2;
    private property <length> origin-y: self.height / 2;
    private property <bool> rippling: false;
    private property <length> dx: max(root.origin-x, max(0px, root.width - root.origin-x));
    private property <length> dy: max(root.origin-y, max(0px, root.height - root.origin-y));
    private property <length> max-radius: max(root.dx, root.dy) + 0.45 * min(root.dx, root.dy);
    border-radius: root.corner-radius;
    clip: true;

    public function trigger(x: length, y: length) {
        root.rippling = false;
        root.origin-x = clamp(x, 0px, root.width);
        root.origin-y = clamp(y, 0px, root.height);
        start-timer.restart();
        stop-timer.restart();
    }

    public function trigger-center() {
        root.trigger(root.width / 2, root.height / 2);
    }

    start-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.stop();
            root.rippling = true;
        }
    }

    stop-timer := Timer {
        interval: 430ms;
        running: false;
        triggered => {
            self.stop();
            root.rippling = false;
        }
    }

    wave := Rectangle {
        private property <length> diameter: 0px;
        x: root.origin-x - self.diameter / 2;
        y: root.origin-y - self.diameter / 2;
        width: self.diameter;
        height: self.diameter;
        border-radius: self.diameter / 2;
        background: root.ripple-color;
        opacity: 0.24;
    }

    states [
        active when root.rippling : {
            wave.diameter: root.max-radius * 2;
            wave.opacity: 0.0;
            in {
                animate wave.diameter { duration: 360ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
                animate wave.opacity { duration: 420ms; easing: ease-out; }
            }
        }
    ]
}

export component HelpfulButton inherits Rectangle {
    in property <string> help;
    in property <length> help-offset-x;
    in property <length> help-offset-y;
    in property <bool> help-beside;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> active;
    out property <bool> has-focus: focus.has-focus;
    callback clicked;
    min-width: 0px;
    preferred-width: label.preferred-width + 24px;
    preferred-height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.brass
        : root.primary ? #c8b257
        : root.active ? Theme.iris
        : !root.enabled ? Theme.border
        : pointer.has-hover ? Theme.selection-border : Theme.border;
    background: !root.enabled ? (root.primary ? #353024 : Theme.inset)
        : root.primary ? (pointer.pressed ? #c8b257 : pointer.has-hover ? #e5d178 : Theme.brass)
        : root.active ? (pointer.pressed ? Theme.inset : pointer.has-hover ? Theme.hover : Theme.selection)
        : (pointer.pressed ? Theme.inset : pointer.has-hover ? Theme.hover : Theme.panel);
    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-description: root.help;
    accessible-action-default => {
        if root.enabled {
            ripple.trigger-center();
            Help.dismiss();
            root.clicked();
        }
    }
    ripple := InkRipple {
        width: parent.width;
        height: parent.height;
        corner-radius: parent.border-radius;
        ripple-color: root.primary ? Theme.canvas : Theme.text;
    }
    label := Text {
        x: 10px;
        width: max(0px, parent.width - 20px);
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Theme.quiet
            : root.primary ? Theme.canvas
            : root.active ? Theme.text
            : Theme.text;
        font-size: 12px;
        font-weight: root.primary || root.active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    // A disabled button still allows its containing help area to explain it.
    pointer := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Help.dismiss();
                if root.enabled && event.button == PointerEventButton.left {
                    ripple.trigger(self.mouse-x, self.mouse-y);
                }
            }
        }
        clicked => {
            if root.enabled {
                focus.focus();
                Help.dismiss();
                root.clicked();
            }
        }
        scroll-event(event) => { Help.dismiss(); return reject; }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == " " || event.text == "\n") {
                ripple.trigger-center();
                Help.dismiss();
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    HelpTracker { copy: root.help; hovered: pointer.has-hover; focused: focus.has-focus;
        anchor-x: root.absolute-position.x + root.help-offset-x; anchor-y: root.absolute-position.y + root.help-offset-y; beside: root.help-beside; anchor-height: root.height;
    }
}

// Workbench selector: fixed geometry, quiet rows and a brass selection rule.
export component HelpfulPicker inherits Rectangle {
    in property <string> help;
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    in-out property <string> current-value: root.model[root.current-index];
    private property <int> active-index: root.current-index;
    private property <bool> expanded;
    private property <length> anchor-x: root.absolute-position.x;
    private property <length> anchor-y: root.absolute-position.y;
    changed anchor-x => { popup.close(); root.expanded = false; }
    changed anchor-y => { popup.close(); root.expanded = false; }
    changed width => { popup.close(); root.expanded = false; }
    private property <length> menu-height: min(8, root.model.length) * 36px + 8px;
    callback selected(string);
    forward-focus: focus;
    accessible-role: combobox;
    accessible-description: root.help;
    accessible-value: root.current-value;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-expand => { root.open(); }
    border-radius: 4px;
    border-width: 1px;
    border-color: focus.has-focus || root.expanded ? Theme.brass : Theme.border;
    background: pointer.has-hover && root.enabled ? Theme.hover : Theme.inset;
    animate background { duration: 140ms; easing: ease-out; }
    changed model => {
        root.current-index = clamp(root.current-index, 0, max(0, root.model.length - 1));
        root.current-value = root.model.length > 0 ? root.model[root.current-index] : "";
        popup.close(); root.expanded = false;
    }
    changed current-index => { root.current-value = root.model[root.current-index]; }
    changed enabled => { if !root.enabled { popup.close(); root.expanded = false; } }
    public function open() {
        if root.enabled && root.model.length > 0 {
            Help.dismiss();
            root.active-index = clamp(root.current-index, 0, root.model.length - 1);
            root.expanded = true;
            popup.show();
        }
    }
    public function choose(index: int) {
        if root.enabled && index >= 0 && index < root.model.length {
            root.current-index = index;
            root.current-value = root.model[index];
            Help.dismiss();
            root.selected(root.current-value);
        }
    }
    Text {
        x: 12px; width: max(0px, parent.width - 44px);
        text: root.current-value; color: root.enabled ? Theme.text : Theme.quiet;
        font-size: 12px; vertical-alignment: center; overflow: elide;
    }
    Path {
        x: parent.width - 28px; y: (parent.height - 8px) / 2;
        width: 12px; height: 8px;
        commands: root.expanded ? "M 1 6 L 6 1 L 11 6" : "M 1 1 L 6 6 L 11 1";
        stroke: Theme.muted; stroke-width: 1.5px;
    }
    pointer := TouchArea {
        enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
        clicked => { focus.focus(); root.open(); }
        scroll-event(event) => { Help.dismiss(); return reject; }
    }
    focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow {
                root.open(); return accept;
            }
            if event.text == Key.UpArrow { root.choose(max(0, root.current-index - 1)); return accept; }
            return reject;
        }
    }
    HelpTracker { copy: root.help; hovered: pointer.has-hover && !root.expanded; focused: focus.has-focus && !root.expanded;
        anchor-x: root.absolute-position.x; anchor-y: root.absolute-position.y; anchor-height: root.height;
    }
    popup := PopupWindow {
        x: 0px;
        y: root.absolute-position.y + root.height + root.menu-height + 4px <= Help.window-height ? root.height + 4px : -root.menu-height - 4px;
        width: root.width; height: root.menu-height;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            focus-changed-event => { root.expanded = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.Escape { popup.close(); root.expanded = false; focus.focus(); return accept; }
                if event.text == Key.Tab { popup.close(); root.expanded = false; return reject; }
                if event.text == Key.Return || event.text == " " { root.choose(root.active-index); popup.close(); root.expanded = false; return accept; }
                if event.text == Key.UpArrow { root.active-index = max(0, root.active-index - 1); return accept; }
                if event.text == Key.DownArrow { root.active-index = min(root.model.length - 1, root.active-index + 1); return accept; }
                if event.text == Key.Home { root.active-index = 0; return accept; }
                if event.text == Key.End { root.active-index = root.model.length - 1; return accept; }
                return reject;
            }
            Rectangle {
                background: Theme.surface; border-width: 1px; border-color: Theme.selection-border; border-radius: 4px;
                ScrollView {
                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    viewport-y: -max(0, root.active-index - 7) * 36px;
                    VerticalLayout {
                        spacing: 0px; alignment: start;
                        for value[index] in root.model: Rectangle {
                            init => { if value == root.current-value { root.active-index = index; } }
                            private property <bool> opening: root.expanded;
                            changed opening => { if self.opening && value == root.current-value { root.active-index = index; } }
                            height: 36px;
                            accessible-role: button; accessible-label: value;
                            accessible-checkable: true; accessible-checked: value == root.current-value;
                            accessible-action-default => { root.choose(index); popup.close(); root.expanded = false; }
                            background: row.has-hover ? Theme.hover : index == root.active-index ? Theme.selection : transparent;
                            Rectangle { x: 0px; y: 8px; width: 2px; height: 20px; background: value == root.current-value ? Theme.brass : transparent; }
                            Text { x: 12px; width: max(0px, parent.width - 24px); text: value; color: value == root.current-value ? Theme.text : Theme.body;
                                font-size: 12px; vertical-alignment: center; overflow: elide;
                            }
                            row := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.choose(index); popup.close(); root.expanded = false; } }
                        }
                    }
                }
            }
        }
    }
}

export component HelpBubble inherits Rectangle {
    in property <string> copy;
    width: 344px; height: message.preferred-height + 24px;
    background: Theme.panel; border-color: Theme.selection-border; border-width: 1px; border-radius: 4px;
    accessible-role: text; accessible-label: root.copy;
    message := Text { x: 12px; y: 12px; width: parent.width - 24px; text: root.copy; color: Theme.text; font-size: 12px; wrap: word-wrap; }
}

export component Hint inherits Rectangle {
    in property <string> copy;
    in property <image> icon;
    width: 24px; height: 24px; horizontal-stretch: 0; vertical-stretch: 0;
    accessible-role: button; accessible-label: "Help"; accessible-description: root.copy;
    accessible-action-default => { hint-focus.focus(); Help.suppressed = false; Help.show(root.copy, root.absolute-position.x, root.absolute-position.y, root.height, false); }
    forward-focus: hint-focus;
    Rectangle { x: 4px; y: 4px; width: 16px; height: 16px; border-radius: 8px;
        border-width: root.icon.width > 0 && !hint-focus.has-focus ? 0px : 1px; border-color: hint-focus.has-focus ? Theme.brass : Theme.muted;
        background: pointer.has-hover ? Theme.hover : transparent;
        if root.icon.width == 0: Text { text: "?"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.icon.width > 0: Image { x: 4px; y: 4px; width: 16px; height: 16px; source: root.icon; colorize: Theme.muted; image-fit: contain; }
    pointer := TouchArea { mouse-cursor: help; clicked => { hint-focus.focus(); Help.suppressed = false; Help.show(root.copy, root.absolute-position.x, root.absolute-position.y, root.height, false); } }
    hint-focus := FocusScope { width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { Help.suppressed = false; Help.show(root.copy, root.absolute-position.x, root.absolute-position.y, root.height, false); return accept; }
            return reject;
        }
    }
    HelpTracker { copy: root.copy; hovered: pointer.has-hover; focused: hint-focus.has-focus;
        anchor-x: root.absolute-position.x; anchor-y: root.absolute-position.y; anchor-height: root.height;
    }
}
