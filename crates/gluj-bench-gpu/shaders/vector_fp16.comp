#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) writeonly buffer Output { vec4 values[]; } output_data;
layout(push_constant) uniform Params {
    uint loop_count;
    uint seed;
    uint invocation_count;
    uint padding;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.invocation_count) { return; }
    float16_t base = float16_t(float((index ^ params.seed) & 255u) * 0.001 + 0.25);
    f16vec2 a0 = f16vec2(base + float16_t(0.01), base + float16_t(0.02));
    f16vec2 a1 = a0 + f16vec2(0.03); f16vec2 a2 = a0 + f16vec2(0.05);
    f16vec2 a3 = a0 + f16vec2(0.07); f16vec2 a4 = a0 + f16vec2(0.09);
    f16vec2 a5 = a0 + f16vec2(0.11); f16vec2 a6 = a0 + f16vec2(0.13);
    f16vec2 a7 = a0 + f16vec2(0.15); f16vec2 a8 = a0 + f16vec2(0.17);
    f16vec2 a9 = a0 + f16vec2(0.19); f16vec2 a10 = a0 + f16vec2(0.21);
    f16vec2 a11 = a0 + f16vec2(0.23); f16vec2 a12 = a0 + f16vec2(0.25);
    f16vec2 a13 = a0 + f16vec2(0.27); f16vec2 a14 = a0 + f16vec2(0.29);
    f16vec2 a15 = a0 + f16vec2(0.31);
    const f16vec2 mul0 = f16vec2(1.0009765625);
    const f16vec2 mul1 = f16vec2(0.99951171875);
    for (uint i = 0; i < params.loop_count; ++i) {
        a0 = fma(a0,mul0,f16vec2(0.0009765625)); a1 = fma(a1,mul1,f16vec2(0.001953125));
        a2 = fma(a2,mul0,f16vec2(0.0029296875)); a3 = fma(a3,mul1,f16vec2(0.00390625));
        a4 = fma(a4,mul0,f16vec2(0.0048828125)); a5 = fma(a5,mul1,f16vec2(0.005859375));
        a6 = fma(a6,mul0,f16vec2(0.0068359375)); a7 = fma(a7,mul1,f16vec2(0.0078125));
        a8 = fma(a8,mul0,f16vec2(0.0087890625)); a9 = fma(a9,mul1,f16vec2(0.009765625));
        a10 = fma(a10,mul0,f16vec2(0.0107421875)); a11 = fma(a11,mul1,f16vec2(0.01171875));
        a12 = fma(a12,mul0,f16vec2(0.0126953125)); a13 = fma(a13,mul1,f16vec2(0.013671875));
        a14 = fma(a14,mul0,f16vec2(0.0146484375)); a15 = fma(a15,mul1,f16vec2(0.015625));
    }
    f16vec2 sum = a0+a1+a2+a3+a4+a5+a6+a7+a8+a9+a10+a11+a12+a13+a14+a15;
    output_data.values[index] = vec4(float(sum.x), float(sum.y), float(a0.x+a15.y), float(a7.x+a8.y));
}
